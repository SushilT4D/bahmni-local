{
  "name": "odoo-cloud-source",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "slot.name": "dbz_odoo_down",
    "tasks.max": "1",
    "publication.name": "dbz_odoo_owned",
    "transforms": "route,agg",
    "schema.include.list": "public",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "topic.prefix": "bahmni-cloud",
    "transforms.route.regex": "bahmni-cloud\\.public\\.(.*)",
    "decimal.handling.mode": "double",
    "heartbeat.action.query": "INSERT INTO public.dbz_heartbeat (id, ts) VALUES (1, now()) ON CONFLICT (id) DO UPDATE SET ts = EXCLUDED.ts",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "transforms.route.replacement": "bahmni-cloud.odoo.$1",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "publication.autocreate.mode": "disabled",
    "transforms.agg.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "database.user": "${ODOO_DB_USER}",
    "database.dbname": "${ODOO_DB_NAME}",
    "time.precision.mode": "connect",
    "heartbeat.interval.ms": "60000",
    "transforms.agg.regex": "bahmni-cloud\\.odoo\\.(${HUB_DOWN_ODOO_ALTERNATION})$",
    "database.port": "5432",
    "plugin.name": "pgoutput",
    "slot.stream.params": "origin=none",
    "//down": "Captures, for clinics to pull, only the tables in sync/tables/{odoo,openelis}.conf [down]: scripts/register-odoo.sh fills the table list and the aggregate regex from that list, and refuses to register when it cannot. The publication it reads (dbz_odoo_owned) holds the same tables, with a row filter on each table that has an id.",
    "//origin": "Decodes only what was written at this hub. A row a clinic's up-sink applied here carries that clinic's replication origin and is skipped, so the hub never publishes one clinic's rows to another clinic or back to the clinic that sent them.",
    "key.converter.schemas.enable": "true",
    "database.hostname": "${ODOO_DB_HOST}",
    "database.password": "${ODOO_DB_PASSWORD}",
    "value.converter.schemas.enable": "true",
    "transforms.agg.replacement": "bahmni-cloud.odoo.all",
    "table.include.list": "${HUB_DOWN_ODOO_TABLE_INCLUDE_LIST},public.dbz_heartbeat",
    "snapshot.mode": "no_data",
    "custom.metric.tags": "database=odoo"
  }
}
