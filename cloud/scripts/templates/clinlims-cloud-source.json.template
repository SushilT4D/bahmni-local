{
  "name": "clinlims-cloud-source",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "slot.name": "dbz_clinlims_down",
    "tasks.max": "1",
    "publication.name": "dbz_clinlims_owned",
    "transforms": "agg",
    "schema.include.list": "clinlims",
    "topic.prefix": "bahmni-cloud",
    "decimal.handling.mode": "double",
    "heartbeat.action.query": "INSERT INTO clinlims.dbz_heartbeat (id, ts) VALUES (1, now()) ON CONFLICT (id) DO UPDATE SET ts = EXCLUDED.ts",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "publication.autocreate.mode": "disabled",
    "transforms.agg.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "database.user": "${OPENELIS_DB_USER}",
    "database.dbname": "openelis",
    "time.precision.mode": "connect",
    "heartbeat.interval.ms": "60000",
    "transforms.agg.regex": "bahmni-cloud\\.clinlims\\.(${HUB_DOWN_CLINLIMS_ALTERNATION})$",
    "database.port": "5432",
    "plugin.name": "pgoutput",
    "slot.stream.params": "origin=none",
    "//down": "Captures, for clinics to pull, only the OpenELIS rows in sync/tables/{odoo,openelis}.conf [down]: scripts/register-odoo.sh fills the table list and the aggregate regex from that list, and refuses to register when it cannot. The publication it reads (dbz_clinlims_owned) holds the same tables: the lab rows each kept by one clinic, with no row filter (they keep the clinic's ids, and each clinic's down sink keeps only its own), the lab accounts and the lab test catalogue filtered on the hub's floor and kept by every clinic. All of them travel on one ordered topic, so a row reaches a clinic after the rows it points to.",
    "//origin": "Decodes only what was written at this hub. A row a clinic's up-sink applied here carries that clinic's replication origin and is skipped, so the hub publishes a clinic's lab rows only after a hub lab user has written them, and never sends a clinic's own write back to it or on to another clinic.",
    "key.converter.schemas.enable": "true",
    "database.hostname": "${OPENELIS_DB_HOST}",
    "database.password": "${OPENELIS_DB_PASSWORD}",
    "value.converter.schemas.enable": "true",
    "transforms.agg.replacement": "bahmni-cloud.clinlims.all",
    "table.include.list": "${HUB_DOWN_CLINLIMS_TABLE_INCLUDE_LIST},clinlims.dbz_heartbeat",
    "snapshot.mode": "no_data",
    "schemas.enable": "true",
    "custom.metric.tags": "database=clinlims"
  }
}
