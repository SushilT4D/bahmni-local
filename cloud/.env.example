# Environment for the CLOUD HUB (cloud/). Copy to .env and fill in.
#
# A committed compose file whose required variables are enumerated nowhere is
# a stack that cannot be brought up from a clean clone; this file enumerates
# them.
#
# Every secret below is BLANK on purpose. Non-secret values are kept as working
# defaults. Variables marked REQUIRED use ${VAR:?} in compose and fail the stack
# loudly rather than resolving empty.

# Cloud .env for the cloud node. Value tags: [OK]=verified against repo/handover,
# [GUESS]=needs confirmation, [LOCAL]=this-machine choice, [OFF]=dummy for a
# service we deliberately do not run.

# ---- global --------------------------------------------------------------
TZ=Asia/Kolkata                          # [GUESS] BHS is India; prod likely IST
TIMEZONE_OFFSET=+05:30                   # [GUESS] pairs with TZ
RESTART_POLICY=unless-stopped            # [LOCAL]

# ---- sync core (Kafka/Schema Registry/Kafka Connect): moved to hub/ as its own compose project -- see hub/.env.example ----

# ---- host paths -------------------------------------------------------------
CONTAINER_DATA_PATH=/absolute/path/to/bahmni-local   # [OK] REQUIRED by docker-compose.override.yml's bind mounts

# ---- openmrs (RUN: emr subset) --------------------------------------------
OPENMRS_IMAGE_TAG=iplit-1.0.0-673-24     # [VERIFIED] tag running on bhs-sandbox
OPENMRS_DB_IMAGE_NAME=mysql:5.6          # [GUESS] compose's stock option; IPLIT dump era-matched
OPENMRS_DB_HOST=openmrsdb                # [OK] service name
OPENMRS_DB_NAME=openmrs                  # [OK] sandbox schema name
OPENMRS_DB_USERNAME=openmrs-user         # [LOCAL]
OPENMRS_DB_PASSWORD=
MYSQL_ROOT_USERNAME=root                 # [OK]
MYSQL_ROOT_PASSWORD=
OPENMRS_DB_CREATE_TABLES=false           # [OK] we restore a full dump
OPENMRS_DB_AUTO_UPDATE=false             # [GUESS] IPLIT image should match dump schema; avoid surprise liquibase
OPENMRS_DOCKER_ENV=cloud                 # [GUESS] see MacBook trap 7.2 (setfacl gate)
OMRS_JAVA_MEMORY_OPTS="-Xms1g -Xmx3g"    # [LOCAL] quoted: his scripts `source` this file
# [LOCAL] empty — no inline comment: compose keeps comments on empty values
OMRS_JAVA_SERVER_OPTS=
OMRS_C3P0_MAX_SIZE=50                    # [GUESS] sane default
# [LOCAL] empty
OMRS_DB_EXTRA_ARGS=
OMRS_DEV_DEBUG_PORT=8001                 # [OFF] not published
OPENMRS_HOST=openmrs                     # [OK]
OPENMRS_PORT=8080                        # [OK]
OPENMRS_USERNAME=admin                   # [GUESS] IPLIT default until dump says otherwise
OPENMRS_PASSWORD=
OPENMRS_ATOMFEED_USER=admin              # [VERIFIED] against bhs-sandbox: bahmni/odoo-connect:latest
OPENMRS_ATOMFEED_PASSWORD=
OPENMRS_URL=http://openmrs:8080/openmrs  # [OK] internal
OPENMRS_SESSION_URL=http://openmrs:8080/openmrs/ws/rest/v1/session  # [GUESS]
OPENMRS_ENCOUNTER_FEED_URL=http://openmrs:8080/openmrs/ws/atomfeed/encounter/recent  # [GUESS]
LUCENE_MATCH_TYPE=EXACT                  # [GUESS]
DOCUMENT_MAX_SIZE_MB=25                  # [GUESS]

# ---- bahmni web / config / proxy (RUN) -------------------------------------
BAHMNI_WEB_IMAGE_TAG=bhs-0.0.27          # [VERIFIED] tag running on bhs-sandbox
CONFIG_IMAGE_NAME=infoiplitin/clinic-config-indiadistro  # [VERIFIED] from bhs-sandbox
CONFIG_IMAGE_TAG=bhs-0.0.19              # [VERIFIED] tag running on bhs-sandbox
CONFIG_VOLUME=bahmni-config              # [OK] declared volume name (parse-verified)
PROXY_IMAGE_TAG=latest                   # [GUESS] bahmniindiadistro/proxy
CERTIFICATE_PATH=   # absolute path on THIS host
BAHMNI_APPS_PATH=/dev/null               # [OFF] dev bind mounts not used
APPOINTMENTS_PATH=/dev/null              # [OFF]
IMPLEMENTER_INTERFACE_CODE_PATH=/dev/null # [OFF]
PATIENT_DOCUMENTS_TAG=1.0.0              # [GUESS]
APPOINTMENTS_IMAGE_TAG=1.0.0             # [OFF] not in subset
IMPLEMENTER_INTERFACE_IMAGE_TAG=1.0.0    # [OFF]

# ---- odoo 10 (RUN: odoo subset) --------------------------------------------
ODOO_IMAGE_TAG=latest                     # [VERIFIED] against bhs-sandbox: bahmni/odoo-10:latest
ODOO_DB_IMAGE_TAG=demo-latest            # [GUESS] bahmni/odoo-10-db, mirrors old standard .env
ODOO_CONNECT_IMAGE_TAG=latest             # [GUESS]
ODOO_DB_HOST=openelisdb                      # [OK]
ODOO_DB_NAME=odoo                        # [OK]
ODOO_DB_USER=odoo                        # [OK] odoo-10 convention
ODOO_DB_PASSWORD=
ODOO_HOST=odoo                           # [OK]
ODOO_PORT=8069                           # [OK]
ODOO_ATOMFEED_USER=admin                 # [GUESS] odoo-10 era used admin/admin
ODOO_ATOMFEED_PASSWORD=
ODOO_DB_DUMP_PATH=/dev/null              # [OFF]
BAHMNI_ODOO_MODULES_PATH=/dev/null       # [OFF]
EXTRA_ADDONS_PATH=/dev/null              # [OFF]

# ---- openelis (DB ONLY, app OFF — mirrors prod) -----------------------------
OPENELIS_DB_IMAGE_TAG=1.0.0              # [GUESS] bahmni/openelis-db
OPENELIS_DB_HOST=openelisdb              # [OK]
OPENELIS_DB_SERVER=openelisdb            # [GUESS]
OPENELIS_DB_USER=clinlims                # [OK] convention
OPENELIS_DB_PASSWORD=
OPENELIS_DB_DUMP_PATH=/dev/null          # [OFF]
OPENELIS_IMAGE_TAG=1.0.0                 # [OFF] app not run
OPENELIS_HOST=openelis                   # [OFF]
OPENELIS_PORT=8080                       # [OFF]
OPENELIS_ATOMFEED_USER=atomfeed          # [OFF]
OPENELIS_ATOMFEED_PASSWORD=

# ---- everything below: NOT RUN — dummy values only --------------------------
