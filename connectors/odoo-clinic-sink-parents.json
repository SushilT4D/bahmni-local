{
  "name": "odoo-clinic-sink-parents",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "connection.url": "jdbc:postgresql://bahmni-postgres:5432/odoo",
    "connection.username": "odoo_sink",
    "connection.password": "${ODOO_SINK_PASSWORD}",
    "topics": "remote.bahmni-cloud.odoo.product_category,remote.bahmni-cloud.odoo.product_uom,remote.bahmni-cloud.odoo.product_template",
    "insert.mode": "upsert",
    "primary.key.mode": "record_key",
    "delete.enabled": "false",
    "schema.evolution": "none",
    "table.name.format": "public.${topic}",
    "hibernate.c3p0.min_size": "1",
    "hibernate.c3p0.max_size": "2",
    "hibernate.c3p0.acquire_increment": "1",
    "hibernate.c3p0.timeout": "1800",
    "hibernate.c3p0.idle_test_period": "300",
    "hibernate.c3p0.preferredTestQuery": "SELECT 1",
    "hibernate.c3p0.testConnectionOnCheckout": "true",
    "connection.restart.on.errors": "true",
    "errors.retry.timeout": "-1",
    "errors.retry.delay.max.ms": "60000",
    "flush.max.retries": "10",
    "transforms": "filterOrigin,route",
    "transforms.filterOrigin.type": "io.debezium.transforms.Filter",
    "transforms.filterOrigin.language": "jsr223.groovy",
    "transforms.filterOrigin.topic.regex": "remote\\.bahmni-cloud\\.odoo\\..*",
    "transforms.filterOrigin.condition": "{ -> def r = (value.op == 'd' ? value.before : value.after); if (r == null) return true; if (r.schema().field('sync_origin') == null) return true; def o = r.get('sync_origin'); return o != '${NODE}'; }()",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "remote\\.bahmni-cloud\\.odoo\\.(.*)",
    "transforms.route.replacement": "$1",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "true",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",
    "name": "odoo-clinic-sink-parents"
  }
}
