{
  "name": "clinlims-clinic-sink-all",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "connection.password": "${CLINLIMS_SINK_PASSWORD}",
    "tasks.max": "1",
    "hibernate.c3p0.idle_test_period": "300",
    "hibernate.c3p0.preferredTestQuery": "SELECT 1",
    "hibernate.c3p0.testConnectionOnCheckout": "true",
    "collection.name.format": "clinlims.${source.table}",
    "auto.evolve": "false",
    "schema.evolution": "basic",
    "flush.retry.delay.ms": "2000",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "errors.log.enable": "true",
    "insert.mode": "upsert",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "errors.retry.timeout": "-1",
    "connection.restart.on.errors": "true",
    "primary.key.mode": "record_key",
    "connection.pool.acquire_increment": "1",
    "topics": "remote.bahmni-cloud.clinlims.all",
    "connection.username": "clinlims_sink",
    "hibernate.c3p0.connectionCustomizerClassName": "t4d.sync.SyncOriginCustomizer",
    "errors.retry.delay.max.ms": "60000",
    "flush.max.retries": "10",
    "key.converter.schemas.enable": "true",
    "connection.pool.max_size": "2",
    "hibernate.c3p0.timeout": "1800",
    "delete.enabled": "true",
    "consumer.override.auto.offset.reset": "earliest",
    "value.converter.schemas.enable": "true",
    "errors.tolerance": "none",
    "auto.create": "false",
    "connection.url": "jdbc:postgresql://bahmni-postgres:5432/openelis",
    "connection.pool.min_size": "1"
  }
}
