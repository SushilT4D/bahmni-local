{
  "name": "odoo-ghated-sink",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "connection.url": "jdbc:postgresql://openelisdb:5432/odoo",
    "connection.username": "odoo_sink",
    "connection.password": "${ODOO_SINK_PASSWORD}",
    "topics": "ghated.bahmni-ghated.odoo.res_partner,ghated.bahmni-ghated.odoo.product_template,ghated.bahmni-ghated.odoo.product_product,ghated.bahmni-ghated.odoo.product_category,ghated.bahmni-ghated.odoo.product_uom,ghated.bahmni-ghated.odoo.sale_order,ghated.bahmni-ghated.odoo.sale_order_line,ghated.bahmni-ghated.odoo.stock_move,ghated.bahmni-ghated.odoo.stock_quant,ghated.bahmni-ghated.odoo.stock_picking,ghated.bahmni-ghated.odoo.account_invoice,ghated.bahmni-ghated.odoo.account_invoice_line",
    "insert.mode": "upsert",
    "primary.key.mode": "record_key",
    "delete.enabled": "false",
    "schema.evolution": "none",
    "table.name.format": "public.${topic}",
    "hibernate.c3p0.min_size": "1",
    "hibernate.c3p0.max_size": "2",
    "hibernate.c3p0.acquire_increment": "1",
    "hibernate.c3p0.timeout": "1800",
    "hibernate.c3p0.idle_test_period": "300",
    "hibernate.c3p0.preferredTestQuery": "SELECT 1",
    "hibernate.c3p0.testConnectionOnCheckout": "true",
    "connection.restart.on.errors": "true",
    "errors.retry.timeout": "-1",
    "errors.retry.delay.max.ms": "60000",
    "flush.max.retries": "10",
    "transforms": "route",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "ghated\\.bahmni-ghated\\.odoo\\.(.*)",
    "transforms.route.replacement": "$1",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "true",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",
    "name": "odoo-ghated-sink"
  }
}
