# sync/fleet/kojawada.env -- fleet registry entry: the non-secret identity the installer
# needs for this clinic (`install.sh --clinic kojawada`). Kojawada, BHS Amrit Clinic; residue 6.
# MRN prefix from the BHS database (idgen source 7). Residue: sync/clinics.txt only.
# CLINIC_PHONE is the placeholder every node runs today; CERT_HOSTNAME empty means
# the installer asks (default: the host's own name) or takes --cert-hostname.
CLINIC_SLUG=kojawada
MRN_PREFIX=KOJ
SITE_NUMBER=6
CLINIC_PHONE=+910000000000
CERT_HOSTNAME=
