# sync/fleet/azure.env -- fleet registry entry: the non-secret identity the installer
# needs for this clinic (`install.sh --clinic azure`). TEST clinic on an Azure VM (Linux, Docker): the installer's first live run. Not a BHS clinic; residue 7 is spent on it until it is retired.
# MRN prefix from the BHS database (idgen source none (new prefix)). Residue: sync/clinics.txt only.
# CLINIC_PHONE is the placeholder every node runs today; CERT_HOSTNAME empty means
# the installer asks (default: the host's own name) or takes --cert-hostname.
CLINIC_SLUG=azure
MRN_PREFIX=AZR
SITE_NUMBER=7
CLINIC_PHONE=+910000000000
CERT_HOSTNAME=
