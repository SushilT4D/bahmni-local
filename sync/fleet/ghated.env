# sync/fleet/ghated.env -- fleet registry entry: the non-secret identity the installer
# needs for this clinic (`install.sh --clinic ghated`). Ghated, BHS Amrit Clinic; residue 3; lab clinic 2 today (podman, BHS_LOCATION=h2).
# MRN prefix from the BHS database (idgen source 2). Residue: sync/clinics.txt only.
# CLINIC_PHONE is the placeholder every node runs today; CERT_HOSTNAME empty means
# the installer asks (default: the host's own name) or takes --cert-hostname.
CLINIC_SLUG=ghated
MRN_PREFIX=GHA
SITE_NUMBER=3
CLINIC_PHONE=+910000000000
CERT_HOSTNAME=
