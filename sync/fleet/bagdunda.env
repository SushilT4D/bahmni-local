# sync/fleet/bagdunda.env -- fleet registry entry: the non-secret identity the installer
# needs for this clinic (`install.sh --clinic bagdunda`). Bagdunda, BHS Amrit Clinic; residue 5. Prefix is BAD, not BAG.
# MRN prefix from the BHS database (idgen source 9). Residue: sync/clinics.txt only.
# CLINIC_PHONE is the placeholder every node runs today; CERT_HOSTNAME empty means
# the installer asks (default: the host's own name) or takes --cert-hostname.
CLINIC_SLUG=bagdunda
MRN_PREFIX=BAD
SITE_NUMBER=5
CLINIC_PHONE=+910000000000
CERT_HOSTNAME=
