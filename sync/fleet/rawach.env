# sync/fleet/rawach.env -- fleet registry entry: the non-secret identity the installer
# needs for this clinic (`install.sh --clinic rawach`). Rawach, BHS Amrit Clinic; residue 4; lab clinic 1 today (docker, BHS_LOCATION=h1).
# MRN prefix from the BHS database (idgen source 6). Residue: sync/clinics.txt only.
# CLINIC_PHONE is the placeholder every node runs today; CERT_HOSTNAME empty means
# the installer asks (default: the host's own name) or takes --cert-hostname.
CLINIC_SLUG=rawach
MRN_PREFIX=RAW
SITE_NUMBER=4
CLINIC_PHONE=+910000000000
CERT_HOSTNAME=
