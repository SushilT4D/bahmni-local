# sync/fleet/morwal.env -- fleet registry entry: Morwal, BHS Amrit Clinic.
# NO RESIDUE ALLOCATED: sync/clinics.txt has no morwal row, so `install.sh
# --clinic morwal` refuses (a node with no residue cannot join).
# 12,882 patients, MRN prefix MOR (idgen source 8). The operator allocates with
# `skills/install-clinic.sh allocate morwal <free residue>` -- never by editing
# this file. SITE_NUMBER empty = the residue, once there is one.
CLINIC_SLUG=morwal
MRN_PREFIX=MOR
SITE_NUMBER=
CLINIC_PHONE=+910000000000
CERT_HOSTNAME=
