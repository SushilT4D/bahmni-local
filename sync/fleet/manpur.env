# sync/fleet/manpur.env -- fleet registry entry: the non-secret identity the installer
# needs for this clinic (`install.sh --clinic manpur`). Manpur, BHS Amrit Clinic; residue 1.
# MRN prefix from the BHS database (idgen source 4). Residue: sync/clinics.txt only.
# CLINIC_PHONE is the placeholder every node runs today; CERT_HOSTNAME empty means
# the installer asks (default: the host's own name) or takes --cert-hostname.
CLINIC_SLUG=manpur
MRN_PREFIX=MAN
SITE_NUMBER=1
CLINIC_PHONE=+910000000000
CERT_HOSTNAME=
