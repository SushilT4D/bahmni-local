# sync/versions.env -- the fleet's image pins. The hub and every clinic run exactly
# these (lockstep, cloud first). Change here, nowhere else; both
# installers copy every key into the rendered .env (lib.sh versions_put), and both
# compose files reference the variables. Non-secret: this repo is public.

# --- sync layer (ours, identical on hub and clinic) ---
KAFKA_IMAGE=confluentinc/cp-kafka:8.3.2                    # Apache Kafka 4.3.x, KRaft only, Java 21
MM2_IMAGE=confluentinc/cp-kafka-connect:8.3.2               # runs connect-mirror-maker
DEBEZIUM_CONNECT_IMAGE=quay.io/debezium/connect:3.6.2.Final  # MySQL 8.0.x, PG 16, Java 17+
DEBEZIUM_SCRIPTING_VERSION=3.6.2.Final                       # Filter SMT jar, fetched by config/kafka-connect/ext/fetch-scripting-jars.sh
GROOVY_VERSION=4.0.17                                        # version.groovy read from io.debezium:debezium-bom:3.6.2.Final's pom

# --- applications (staging's: bhs-sandbox.bahmni.in) ---
# The keys in clinic/install/lib.sh IMAGE_KEYS are the IPLIT and Bahmni
# application images. These values are the defaults; the person installing a
# clinic may choose other versions (install.sh --versions <file>, or the prompt).
# The sync layer above is never a per-node choice.
OPENMRS_IMAGE_NAME=infoiplitin/openmrs:iplit-1.2.0-1200-03   # Java 8u432; no -XX:-UseContainerSupport needed
OPENMRS_ARM64_BASE_IMAGE=amazoncorretto:8u432-al2            # arm64 lab Macs only: openmrs/build-native.sh's base. Same OS family (Amazon Linux 2) and Corretto 8u432 JDK as OPENMRS_IMAGE_NAME's image; never used on x86 clinics.
MYSQL_IMAGE=mysql:8.0.39                                     # staging: bahmni/openmrs-db:1.0.0-standard = 8.0.39
POSTGRES_IMAGE=postgres:16                                   # shared odoo + openelis instance on a clinic; staging Odoo DB is 16.4
ODOO_IMAGE_NAME=bahmni/odoo-16:1.0.0
ODOO_CONNECT_IMAGE_TAG=1.0.0                                 # five feeds; markers in the odoo database
OPENELIS_IMAGE_TAG=1.1.0-111                                 # stated deviation from staging's stale 1.0.0-99
BAHMNI_WEB_IMAGE=infoiplitin/bahmni-iplit-web:bhs-0.0.30    # staging's UI. A clinic does not RUN it: clinic/scripts/extract-ui-config.sh copies its htdocs out for the clinic's nginx
BAHMNI_CONFIG_IMAGE=infoiplitin/clinic-config-indiadistro:bhs-0.0.20   # staging's config; extracted the same way, one tree for proxy + openmrs + openelis
IMPLEMENTER_INTERFACE_IMAGE_TAG=1.1.0-74                     # staging's; its `latest` is a different major version
PATIENT_DOCUMENTS_TAG=1.1.0-32                               # staging's; its `latest` is a different major version
ATOMFEED_CONSOLE_IMAGE_TAG=1.0.0-23                          # staging's
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0                # hub only (task 070); newest stable v1.x verified live via docker manifest inspect

# The disposable data a clinic runs on between install and seed: IPLIT's own
# database images (what its standard package starts from). Nothing in them is
# kept; the seed replaces all three.
BASELINE_OPENMRS_IMAGE=bahmni/openmrs-db:1.0.0-standard
BASELINE_ODOO_IMAGE=bahmni/odoo-16-db:1.0.0-standard
BASELINE_OPENELIS_IMAGE=bahmni/openelis-db:demo-latest
