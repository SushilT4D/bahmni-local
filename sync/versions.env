# sync/versions.env -- the fleet's image pins. The hub and every clinic run exactly
# these (constitution L-005: lockstep, cloud first). Change here, nowhere else; both
# installers copy every key into the rendered .env (lib.sh versions_put), and both
# compose files reference the variables. Non-secret: this repo is public.
# Fixed by docs/superpowers/specs/2026-09-17-hub-sync-layer-design.md §10.2.

# --- sync layer (ours, identical on hub and clinic) ---
KAFKA_IMAGE=confluentinc/cp-kafka:8.3.2                    # Apache Kafka 4.3.x, KRaft only, Java 21
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:8.3.2
MM2_IMAGE=confluentinc/cp-kafka-connect:8.3.2               # runs connect-mirror-maker
DEBEZIUM_CONNECT_IMAGE=quay.io/debezium/connect:3.6.2.Final  # MySQL 8.0.x, PG 16, Java 17+
DEBEZIUM_SCRIPTING_VERSION=3.6.2.Final                       # Filter SMT jar, fetched by config/kafka-connect/ext/fetch-scripting-jars.sh
GROOVY_VERSION=4.0.17                                        # version.groovy read from io.debezium:debezium-bom:3.6.2.Final's pom (Task 2; was wrongly 4.0.22)

# --- applications (staging's, read 2026-09-17: bhs-sandbox.bahmni.in) ---
OPENMRS_IMAGE_NAME=infoiplitin/openmrs:iplit-1.2.0-1200-03   # Java 8u432; no -XX:-UseContainerSupport needed
MYSQL_IMAGE=mysql:8.0.39                                     # staging: bahmni/openmrs-db:1.0.0-standard = 8.0.39
POSTGRES_IMAGE=postgres:16                                   # shared odoo + openelis instance on a clinic; staging Odoo DB is 16.4
ODOO_IMAGE_NAME=bahmni/odoo-16:1.0.0
ODOO_CONNECT_IMAGE_TAG=1.0.0                                 # five feeds; markers in the odoo database
OPENELIS_IMAGE_TAG=1.1.0-111                                 # stated deviation from staging's stale 1.0.0-99 (§10.2 decision 14)
