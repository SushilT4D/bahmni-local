{
  "name": "mysql-local-sink-${TABLE}",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",

    "//topics": "MirrorMaker's DefaultReplicationPolicy prefixes a mirrored topic with the",
    "//topics2": "alias of the cluster it came FROM. For remote->source that alias is 'remote',",
    "//topics3": "so the cloud's bahmni-cloud.openmrs.users arrives here as",
    "//topics4": "remote.bahmni-cloud.openmrs.users.",
    "topics": "${KAFKA_TOPICS}",

    "connection.url": "jdbc:mysql://${LOCAL_MYSQL_HOST}:${LOCAL_MYSQL_PORT}/${LOCAL_MYSQL_DATABASE}?useSSL=${LOCAL_MYSQL_USE_SSL}&allowPublicKeyRetrieval=true&sessionVariables=sql_log_bin=0",
    "connection.username": "${LOCAL_MYSQL_USER}",
    "connection.password": "${LOCAL_MYSQL_PASSWORD}",

    "//BL-039": "THE FIX. Default is false: a connection-level error (e.g. MySQL's 8h",
    "//BL-039b": "wait_timeout closing an idle pooled connection overnight) is treated as",
    "//BL-039c": "UNRECOVERABLE and kills the task permanently, while the connector still",
    "//BL-039d": "reports RUNNING. This direction is the MORE exposed one: users/roles change",
    "//BL-039e": "every few days, so its pools idle far longer than the up direction's.",
    "//BL-039f": "Safe here because each sink DB is a single instance; the upstream caveat",
    "//BL-039g": "about async-replica failover does not apply.",
    "connection.restart.on.errors": "true",
    "errors.retry.timeout": "-1",
    "errors.retry.delay.max.ms": "60000",
    "flush.max.retries": "10",
    "//pool": "BL-039 durable fix, 2026-08-28. Second layer only -- the primary defence is",
    "//pool2": "server-side: wait_timeout is now 604800 on both nodes (was the stock 28800).",
    "//pool3": "DO NOT set connection.pool.min_size=0: tried on 2026-08-28, and 4 of 13 cloud",
    "//pool4": "sinks died on boot with 'Unable to determine Dialect without JDBC metadata'.",
    "//pool5": "Hibernate needs a connection at startup to probe the dialect; an empty pool",
    "//pool6": "has none. min_size stays at its default of 5.",
    "//pool-measured": "MEASURED INERT 2026-08-28. Two samples 317s apart on both nodes:",
    "//pool-measured2": "cloud 60 conns aged 512-517s then 829-834s; clinic 35 conns aged 836s.",
    "//pool-measured3": "Ages tracked wall-clock 1:1 and NOT ONE connection was recycled, so this",
    "//pool-measured4": "key does not expire idle connections at min_size. Kept for the record, but",
    "//pool-measured5": "it protects nothing: wait_timeout=604800 is the entire defence. Do not",
    "//pool-measured6": "count this as a second layer when reasoning about BL-039.",
    "//c3p0": "F-007 REAL FIX, 2026-09-02. connection.pool.timeout above is INERT --",
    "//c3p02": "confirmed from the debezium-connector-jdbc 3.2.4 bytecode: min_size,",
    "//c3p03": "max_size and acquire_increment each have a matching hibernate.c3p0.* literal,",
    "//c3p04": "connection.pool.timeout has NONE, so it is parsed and silently dropped.",
    "//c3p05": "The four keys below DO reach c3p0 via the hibernate.* passthrough and are the",
    "//c3p06": "only client-side defence; they survive a MySQL restart, which the server-side",
    "//c3p07": "wait_timeout does not (see docker-compose.override.yml).",
    "//c3p08": "PROVEN 2026-09-02 on Rawach: killed all 45 sink connections server-side, and",
    "//c3p09": "the next write landed in 5s with every task still RUNNING. Control sink without",
    "//c3p010": "these keys FAILED on the same batch with Broken pipe.",
    "hibernate.c3p0.timeout": "1800",
    "hibernate.c3p0.idle_test_period": "300",
    "hibernate.c3p0.preferredTestQuery": "SELECT 1",
    "hibernate.c3p0.testConnectionOnCheckout": "true",
    "//pool-cap": "F-013 REAL FIX, 2026-09-02. The lever is max_size, NOT min_size.",
    "//pool-cap2": "Measured on the cloud: min_size=5 with an unbounded max held 120 conns for 25",
    "//pool-cap3": "sinks. Lowering to min_size=1 alone made it WORSE -- 493 conns, ceiling hit, 5",
    "//pool-cap4": "sinks FAILED -- because c3p0 then grows by acquire_increment, whose Debezium",
    "//pool-cap5": "default is 32 (25 sinks x 32 = 800 potential). The high min_size had been",
    "//pool-cap6": "accidentally CAPPING the pool by keeping it pre-filled and stable.",
    "//pool-cap7": "min=1 + max=2 + acquire_increment=1 gives a hard bound: 25 sinks -> 48 conns",
    "//pool-cap8": "measured, all tasks RUNNING, cloud->clinic round trip 10s. Per clinic the cost",
    "//pool-cap9": "falls 60 -> 24, so 7 clinics need ~168 + ~30 app, well inside 500.",
    "//pool-cap10": "Do NOT set min_size=0: 4 sinks die on boot with 'Unable to determine Dialect'.",
    "connection.pool.max_size": "2",
    "connection.pool.acquire_increment": "1",
    "connection.pool.timeout": "300",
    "flush.retry.delay.ms": "2000",

    "//strip": "Strip the mirror + server prefix so rows land in the bare table name.",
    "//strip2": "The replacement MUST be a literal $1 -- BL-030 was this value arriving",
    "//strip3": "empty because the generator used an UNQUOTED heredoc and the shell ate it.",
    "transforms": "dropPrefix",
    "transforms.dropPrefix.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.dropPrefix.regex": "${TOPIC_PREFIX_REGEX}",
    "transforms.dropPrefix.replacement": "$1",

    "table.name.format": "${TABLE}",
    "insert.mode": "upsert",
    "primary.key.mode": "record_key",

    "//keys0": "record_key, NOT record_value: delete.enabled REQUIRES record_key, because",
    "//keys00": "a delete carries after=null and the PK can only come from the key. The up",
    "//keys000": "direction uses record_value + delete.enabled=false; this direction must",
    "//keys0000": "propagate deletes, so it uses the key.",
    "//keys": "record_key carries whatever the source PK was, composite included --",
    "//keys2": "user_property(user_id,property), role_privilege(role,privilege),",
    "//keys3": "role_role(parent_role,child_role). No striding is needed in this",
    "//keys4": "direction: the cloud is the sole writer of these tables (L-001).",

    "//delete": "Deletes MUST propagate. This is how a REVOKED user or role reaches a",
    "//delete2": "clinic; dropping deletes would leave revoked staff able to log in (L-006).",
    "delete.enabled": "true",

    "//auto": "auto.create/auto.evolve are OFF by design here. These tables already exist",
    "//auto2": "in the clinic's OpenMRS schema; silently creating or altering one would mask",
    "//auto3": "a genuine schema mismatch instead of surfacing it (L-005).",
    "auto.create": "false",
    "auto.evolve": "false",

    "//errors": "NOT errors.tolerance=all. BL-005: 'all' silently DROPS a failing record and",
    "//errors2": "moves on, so an FK-ordering miss becomes a permanently missing row with only",
    "//errors3": "a log line. Retry instead, and let a genuine failure be loud (L-004).",
    "errors.tolerance": "none",
    "errors.log.enable": "true",
    "//errors4": "include.messages stays FALSE: these payloads are user/provider records.",
    "errors.log.include.messages": "false",

    "//converters": "true on BOTH, matching the source. The JDBC sink needs the schema:",
    "//converters2": "with schemas.enable=false every task dies on",
    "//converters3": "'Configured primary key mode record_key cannot have null schema'.",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "true",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true"
  }
}
