# sync/hub.env -- the fleet's hub endpoint, shared by every clinic. Non-secret:
# this repo is public. The SASL password is NOT here; it travels with the seed
# (<seed>/secrets.env, written by the operator's `install-clinic.sh seed`) or is
# asked at install time. mTLS and per-site ACLs are unmet: one fleet-wide
# user today, and the installer says so.
REMOTE_KAFKA_BOOTSTRAP_SERVERS=kafka.xoyo.ad:9092
REMOTE_KAFKA_USERNAME=mirrormaker
