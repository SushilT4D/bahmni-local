# =============================================================================
# bahmni-local — CLOUD node environment  (debezium/cloud/.env)
# =============================================================================
# Copy to debezium/cloud/.env on the CLOUD host and fill in.
#
# This is a SEPARATE env file from the repo-root .env. The cloud stack is
# deployed from debezium/cloud/, so its scripts source THIS file, not the root
# one — that was commit 3d173c3 ("the cloud stack's env is not at repo root").
# Do not symlink the two together: the clinic and the cloud hold different
# credentials, and merging them re-creates the bug.
#
# QUOTING CONTRACT: same as the root .env — these values are `source`d by shell,
# so any value containing a space, `&`, `!`, `#`, `$`, `;` or `|` MUST be
# double-quoted or it will silently export as an empty string.
# =============================================================================

# ---- cloud OpenMRS MySQL (the Debezium SOURCE on this node) -----------------
# Consumed by scripts/generate-cloud-source-connector.sh (defaults shown).
CLOUD_MYSQL_HOST=openmrsdb
CLOUD_MYSQL_PORT=3306
CLOUD_MYSQL_DATABASE=openmrs
CLOUD_MYSQL_SERVER_NAME=bahmni-cloud
# Must be UNIQUE across every MySQL replication client in the topology —
# a collision silently breaks binlog streaming.
CLOUD_DEBEZIUM_SERVER_ID=184055
CLOUD_KAFKA_BOOTSTRAP=kafka:29092

# ---- Debezium DB credential -------------------------------------------------
# REQUIRED. generate-cloud-source-connector.sh defaults DEBEZIUM_DB_PASSWORD to
# empty, and the connector template substitutes ${DEBEZIUM_DB_PASSWORD} — an
# unset value renders a passwordless connector that fails at POST.
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=<cloud-debezium-db-password>

# Comma-separated db.table list captured by the cloud source connector.
TABLE_INCLUDE_LIST=openmrs.patient,openmrs.person,openmrs.encounter

# ---- UP-direction sink target (clinic data -> this node's OpenMRS DB) --------
# Consumed by scripts/generate-sink-connectors.sh + mysql-sink-connector.json
# .template. "REMOTE_" is legacy naming inherited from the template: these point
# at the MySQL the sink WRITES INTO, which on the cloud node is the cloud
# OpenMRS DB.
REMOTE_MYSQL_HOST=openmrsdb
REMOTE_MYSQL_PORT=3306
REMOTE_MYSQL_DATABASE=openmrs
REMOTE_MYSQL_USER=sink
REMOTE_MYSQL_PASSWORD=<cloud-sink-db-password>
REMOTE_MYSQL_USE_SSL=false

# Source-side naming used to build the topic list the sinks subscribe to.
# MYSQL_SERVER_NAME takes precedence over REMOTE_SOURCE_SERVER_NAME
# (generate-sink-connectors.sh:57); both default to bahmni-local.
MYSQL_SERVER_NAME=bahmni-local
DATABASE_NAME=openmrs
# Fallback used only when MYSQL_SERVER_NAME is unset. Leave commented unless needed.
#REMOTE_SOURCE_SERVER_NAME=bahmni-local

# ---- UP/DOWN table lists (commit 3fae0a0) -----------------------------------
# These sinks consume source.<clinic>.openmrs.* and write CLINIC-authored rows
# into the cloud, so the list must be the CLINIC's table list, not the cloud's.
# TABLES_CONF defaults to ../local/tables.conf; it previously defaulted to the
# cloud's own tables.conf, which emitted 7 up-direction sinks for cloud-owned
# tables (users, role, role_privilege, role_role, user_property, user_role,
# provider) that sat RUNNING on 0 messages.
# Override only if your clinic table list lives elsewhere.
#TABLES_CONF=/absolute/path/to/debezium/local/tables.conf
#
# NOT env-configurable, listed here so the pairing is documented:
#   DOWN_TABLES_CONF is hardcoded to debezium/cloud/tables.conf and drives the
#   L-008 guard at generate-sink-connectors.sh:77 -- the generator REFUSES to
#   emit an up-direction sink for any table listed there.

# ---- Kafka SASL (clinic MirrorMaker 2 authenticates inbound) ----------------
# Credentials are ALSO declared in kafka_server_jaas.conf; keep them in step.
REMOTE_KAFKA_USERNAME=mirrormaker
REMOTE_KAFKA_PASSWORD=<remote-kafka-password>
