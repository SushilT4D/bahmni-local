{
  "//STATUS": "REFERENCE ONLY - NOT THE SOURCE OF TRUTH. Nothing reads this file.",
  "//STATUS2": "It has been orphaned since the initial commit (339dd91): no script, no",
  "//STATUS3": "compose file and no docs reference it. The up-direction cloud sinks are",
  "//STATUS4": "emitted by the heredoc in debezium/cloud/scripts/generate-sink-connectors.sh,",
  "//STATUS5": "and the authoritative SHAPE is debezium/cloud/connectors/known-good.json.",
  "//STATUS6": "Change either of those, never this file, and expect no effect from editing it.",
  "//STATUS7": "Why it is kept: it is the only record of the pre-generator single-connector",
  "//STATUS8": "era (see the sibling register-sink-connector.sh, which still looks for a",
  "//STATUS9": "singular connectors/mysql-sink-connector.json that no longer exists).",
  "//DRIFT": "Values below were reconciled to the generator + live cloud on 2026-08-28",
  "//DRIFT2": "after this file was found contradicting the running system in six places:",
  "//DRIFT3": "errors.tolerance (all -> none; the BL-005 silent-drop setting, and the one",
  "//DRIFT4": "that made this file dangerous rather than merely dead), primary.key.mode,",
  "//DRIFT5": "delete.enabled, table.name, and both converter schemas.enable flags.",
  "//DRIFT6": "Verified against the 12 live mysql-sink-* connectors on the mini, 2026-08-28.",
  "name": "mysql-sink-${TABLE}",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "${KAFKA_TOPICS}",
    "connection.url": "jdbc:mysql://${REMOTE_MYSQL_HOST}:${REMOTE_MYSQL_PORT}/${REMOTE_MYSQL_DATABASE}?useSSL=${REMOTE_MYSQL_USE_SSL}&allowPublicKeyRetrieval=true",
    "connection.username": "${REMOTE_MYSQL_USER}",
    "connection.password": "${REMOTE_MYSQL_PASSWORD}",
    "table.name.format.default": "${TABLE}",
    "insert.mode": "upsert",
    "//BL-039": "ADDED BY US 2026-08-20. Debezium ships connection.restart.on.errors",
    "//BL-039b": "defaulted to FALSE, so a connection-level error (MySQL closing an idle",
    "//BL-039c": "pooled connection after wait_timeout=8h, or a DB restart) is treated as",
    "//BL-039d": "UNRECOVERABLE: the task dies permanently while the connector still reads",
    "//BL-039e": "RUNNING. Observed twice on 2026-08-20 -- overnight idle, then a DB restart",
    "//BL-039f": "-- each time killing the 7 registration-path sinks silently.",
    "connection.restart.on.errors": "true",
    "errors.retry.timeout": "-1",
    "errors.retry.delay.max.ms": "60000",
    "flush.max.retries": "10",
    "//pool": "BL-039 durable fix, 2026-08-28. Second layer only -- the primary defence is",
    "//pool2": "server-side: wait_timeout is now 604800 on both nodes (was the stock 28800).",
    "//pool3": "DO NOT set connection.pool.min_size=0: tried on 2026-08-28, and 4 of 13 cloud",
    "//pool4": "sinks died on boot with 'Unable to determine Dialect without JDBC metadata'.",
    "//pool5": "Hibernate needs a connection at startup to probe the dialect; an empty pool",
    "//pool6": "has none. min_size stays at its default of 5.",
    "//pool-measured": "MEASURED INERT 2026-08-28. Two samples 317s apart on both nodes:",
    "//pool-measured2": "cloud 60 conns aged 512-517s then 829-834s; clinic 35 conns aged 836s.",
    "//pool-measured3": "Ages tracked wall-clock 1:1 and NOT ONE connection was recycled, so this",
    "//pool-measured4": "key does not expire idle connections at min_size. Kept for the record, but",
    "//pool-measured5": "it protects nothing: wait_timeout=604800 is the entire defence. Do not",
    "//pool-measured6": "count this as a second layer when reasoning about BL-039.",
    "//c3p0": "F-007 REAL FIX, 2026-09-02. connection.pool.timeout above is INERT --",
    "//c3p02": "confirmed from the debezium-connector-jdbc 3.2.4 bytecode: min_size,",
    "//c3p03": "max_size and acquire_increment each have a matching hibernate.c3p0.* literal,",
    "//c3p04": "connection.pool.timeout has NONE, so it is parsed and silently dropped.",
    "//c3p05": "The four keys below DO reach c3p0 via the hibernate.* passthrough and are the",
    "//c3p06": "only client-side defence; they survive a MySQL restart, which the server-side",
    "//c3p07": "wait_timeout does not (see docker-compose.override.yml).",
    "//c3p08": "PROVEN 2026-09-02 on Rawach: killed all 45 sink connections server-side, and",
    "//c3p09": "the next write landed in 5s with every task still RUNNING. Control sink without",
    "//c3p010": "these keys FAILED on the same batch with Broken pipe.",
    "hibernate.c3p0.timeout": "1800",
    "hibernate.c3p0.idle_test_period": "300",
    "hibernate.c3p0.preferredTestQuery": "SELECT 1",
    "hibernate.c3p0.testConnectionOnCheckout": "true",
    "//pool-cap": "F-013 REAL FIX, 2026-09-02. The lever is max_size, NOT min_size.",
    "//pool-cap2": "Measured on the cloud: min_size=5 with an unbounded max held 120 conns for 25",
    "//pool-cap3": "sinks. Lowering to min_size=1 alone made it WORSE -- 493 conns, ceiling hit, 5",
    "//pool-cap4": "sinks FAILED -- because c3p0 then grows by acquire_increment, whose Debezium",
    "//pool-cap5": "default is 32 (25 sinks x 32 = 800 potential). The high min_size had been",
    "//pool-cap6": "accidentally CAPPING the pool by keeping it pre-filled and stable.",
    "//pool-cap7": "min=1 + max=2 + acquire_increment=1 gives a hard bound: 25 sinks -> 48 conns",
    "//pool-cap8": "measured, all tasks RUNNING, cloud->clinic round trip 10s. Per clinic the cost",
    "//pool-cap9": "falls 60 -> 24, so 7 clinics need ~168 + ~30 app, well inside 500.",
    "//pool-cap10": "Do NOT set min_size=0: 4 sinks die on boot with 'Unable to determine Dialect'.",
    "connection.pool.max_size": "2",
    "connection.pool.acquire_increment": "1",
    "connection.pool.timeout": "300",
    "//pool-min": "Pinned explicitly to Hibernate's own default so the value is visible",
    "//pool-min2": "next to the DO-NOT-SET-ZERO warning above, not silently inherited.",
    "connection.pool.min_size": "1",
    "//keys": "record_value + an explicit pk field, NOT record_key: the up direction",
    "//keys2": "does not propagate deletes, so the key comes from the value. The strided",
    "//keys3": "integer PK is still the sync key (L-010) - striding, not the UUID, is what",
    "//keys4": "makes it collision-free across clinics.",
    "primary.key.mode": "record_value",
    "primary.key.fields": "${PK_FIELD}",
    "delete.enabled": "false",
    "auto.create": "true",
    "auto.evolve": "true",
    "//errors": "NOT errors.tolerance=all. 'all' silently DROPS a failing record, so an",
    "//errors2": "out-of-order FK row vanishes with no park, no DLQ and no trace - defeating",
    "//errors3": "L-004 (park-and-retry) and L-010. This file carried 'all' until 2026-08-28,",
    "//errors4": "long after the generator and all 12 live cloud sinks moved to 'none';",
    "//errors5": "regenerating from it would have silently re-armed BL-005 across every sink.",
    "errors.tolerance": "none",
    "errors.log.enable": "true",
    "//errors6": "TRUE here only because the generator and all 12 live cloud sinks say true;",
    "//errors7": "this file must not invent a seventh divergence. Flagged, not changed: these",
    "//errors8": "payloads are patient rows, so a failing record is logged in full to the",
    "//errors9": "Connect log. The clinic down-direction template sets false for that reason.",
    "//errors10": "If that is deliberate for the up direction, say so in the generator.",
    "errors.log.include.messages": "true",
    "//converters": "true on BOTH, matching the source and the live connectors. With",
    "//converters2": "schemas.enable=false a task dies on 'Configured primary key mode",
    "//converters3": "record_key cannot have null schema'.",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "true"
  }
}

