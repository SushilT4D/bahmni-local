# MirrorMaker 2.0 Configuration
# This file is used by MirrorMaker Connect to replicate topics from local to remote Kafka

# Cluster definitions
clusters = ${LOCAL_CLUSTER_ALIAS}, remote

# Local cluster (source)
${LOCAL_CLUSTER_ALIAS}.bootstrap.servers = kafka:29092

# Remote cluster (target) - configured via environment variable
remote.bootstrap.servers = ${REMOTE_KAFKA_BOOTSTRAP_SERVERS}

# Enable replication from local to remote
${LOCAL_CLUSTER_ALIAS}->remote.enabled = true
${LOCAL_CLUSTER_ALIAS}->remote.topics = ${KAFKA_TOPIC_PATTERNS}

# Topics to replicate (regex pattern)
# Generated from tables.conf - use specific topics for better control
# Format: server-name.database.table1,server-name.database.table2
# Example: bahmni-local\.openmrs\.(person|patient|visit)

# Consumer configuration (reads from local Kafka)
${LOCAL_CLUSTER_ALIAS}.consumer.bootstrap.servers = kafka:29092
${LOCAL_CLUSTER_ALIAS}.consumer.group.id = ${MIRRORMAKER_CONSUMER_GROUP_ID}
${LOCAL_CLUSTER_ALIAS}.consumer.key.deserializer = org.apache.kafka.common.serialization.ByteArrayDeserializer
${LOCAL_CLUSTER_ALIAS}.consumer.value.deserializer = org.apache.kafka.common.serialization.ByteArrayDeserializer
${LOCAL_CLUSTER_ALIAS}.consumer.auto.offset.reset = earliest
${LOCAL_CLUSTER_ALIAS}.consumer.enable.auto.commit = true
# Buffer size for offline scenarios
${LOCAL_CLUSTER_ALIAS}.consumer.fetch.min.bytes = 1
${LOCAL_CLUSTER_ALIAS}.consumer.fetch.max.wait.ms = 500

# Producer configuration (writes to remote Kafka)
remote.producer.bootstrap.servers = ${REMOTE_KAFKA_BOOTSTRAP_SERVERS}
remote.producer.key.serializer = org.apache.kafka.common.serialization.ByteArraySerializer
remote.producer.value.serializer = org.apache.kafka.common.serialization.ByteArraySerializer
remote.producer.acks = 1
# Infinite retries - will keep trying when offline
remote.producer.retries = 2147483647
# Ensure ordering during reconnection
remote.producer.max.in.flight.requests.per.connection = 1
# Timeout settings for offline handling
# RAISED by us 2026-08-19 (was 120000 = 2 min).
# delivery.timeout.ms is the HARD bound - `retries = MAX_INT` cannot exceed it.
# At 2 min any slow/interrupted link kills the task permanently ("will not recover
# until manually restarted"), defeating the offline-resilience intent. 2h here.
remote.producer.delivery.timeout.ms = 7200000
remote.producer.request.timeout.ms = 120000

# ---- throughput tuning (2026-08-19) ----
# max.in.flight=1 (kept, preserves ordering on retry) serialises batches, so
# throughput = batch size / RTT. Measured RTT ~40 ms => ~25 batches/s. Without
# linger/batching each batch carried <1 record => ~12 msg/s observed.
# Architecture 5.3 prescribes zstd compression for intermittent links.
# These change no ordering or durability semantics.
remote.producer.linger.ms = 200
remote.producer.batch.size = 524288
remote.producer.compression.type = zstd
remote.producer.buffer.memory = 67108864

# Replication settings
replication.policy.separator = .
replication.policy.class = org.apache.kafka.connect.mirror.DefaultReplicationPolicy

# Offset sync (tracks replication progress)
offset-syncs.topic.replication.factor = 1

# Heartbeat (for connectivity monitoring)
heartbeat.interval.seconds = 10

# Checkpoint interval (how often to sync offsets)
checkpoints.topic.replication.factor = 1

# Replication factor for internal topics
replication.factor = 1


# ---- topics (rendered by setup-mirrormaker.sh) ----

# ---- single-broker internal topics ----
${LOCAL_CLUSTER_ALIAS}.offset.storage.replication.factor = 1
${LOCAL_CLUSTER_ALIAS}.config.storage.replication.factor = 1
${LOCAL_CLUSTER_ALIAS}.status.storage.replication.factor = 1
remote.offset.storage.replication.factor = 1
remote.config.storage.replication.factor = 1
remote.status.storage.replication.factor = 1

# ---- down direction (cloud -> clinic). Ported from the hand-edited clinic-1
#      config 2026-08-31: the template could never generate it, so a regenerate
#      would silently drop the whole down direction.
# reverses (we CONSUME from the cloud instead of producing to it). Clinics stay
# behind NAT with no inbound reachability required.
remote->${LOCAL_CLUSTER_ALIAS}.enabled = true
remote->${LOCAL_CLUSTER_ALIAS}.topics = ${KAFKA_DOWN_TOPIC_PATTERNS}

# Consumer — reads from the CLOUD. This is the hop that crosses the internet.
remote.consumer.bootstrap.servers = ${REMOTE_KAFKA_BOOTSTRAP_SERVERS}
remote.consumer.group.id = mirrormaker-down-consumer-${BHS_LOCATION}
remote.consumer.key.deserializer = org.apache.kafka.common.serialization.ByteArrayDeserializer
remote.consumer.value.deserializer = org.apache.kafka.common.serialization.ByteArrayDeserializer
# earliest: a clinic that has been offline drains its backlog rather than skipping it
remote.consumer.auto.offset.reset = earliest
remote.consumer.enable.auto.commit = true
remote.consumer.fetch.min.bytes = 1
remote.consumer.fetch.max.wait.ms = 500

# ---- down-direction producer -----------------------------------------------
# Writes to the CLINIC's own broker, i.e. localhost. Unlike the up direction
# there is no bad link here, so acks=all costs nothing and is the durable
# setting. (The up direction runs acks=1 across the internet - BL-009.)
${LOCAL_CLUSTER_ALIAS}.producer.bootstrap.servers = kafka:29092
${LOCAL_CLUSTER_ALIAS}.producer.key.serializer = org.apache.kafka.common.serialization.ByteArraySerializer
${LOCAL_CLUSTER_ALIAS}.producer.value.serializer = org.apache.kafka.common.serialization.ByteArraySerializer
${LOCAL_CLUSTER_ALIAS}.producer.acks = all
${LOCAL_CLUSTER_ALIAS}.producer.retries = 2147483647
${LOCAL_CLUSTER_ALIAS}.producer.max.in.flight.requests.per.connection = 1
# same lesson as BL-029: retries are capped by delivery.timeout.ms, so raise it
${LOCAL_CLUSTER_ALIAS}.producer.delivery.timeout.ms = 7200000
${LOCAL_CLUSTER_ALIAS}.producer.request.timeout.ms = 120000
