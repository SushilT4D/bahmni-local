# MirrorMaker 2.0 Configuration
# This file is used by MirrorMaker Connect to replicate topics from local to cloud Kafka

# Cluster definitions
clusters = ${BHS_LOCATION}, cloud

# Local cluster (source)
${BHS_LOCATION}.bootstrap.servers = kafka:29092

# Remote cluster (target) - configured via environment variable
cloud.bootstrap.servers = ${REMOTE_KAFKA_BOOTSTRAP_SERVERS}

# Cloud login and truststore, read from the container's environment at start (${env:...}).
config.providers = env
config.providers.env.class = org.apache.kafka.common.config.provider.EnvVarConfigProvider
cloud.security.protocol = ${env:REMOTE_KAFKA_SECURITY_PROTOCOL}
cloud.sasl.mechanism = PLAIN
cloud.sasl.jaas.config = org.apache.kafka.common.security.plain.PlainLoginModule required username="${env:REMOTE_KAFKA_USERNAME}" password="${env:REMOTE_KAFKA_PASSWORD}";
cloud.ssl.truststore.location = /etc/kafka-connect/secrets/kafka.truststore.p12
cloud.ssl.truststore.type = PKCS12
cloud.ssl.truststore.password = ${env:REMOTE_KAFKA_SSL_TRUSTSTORE_PASSWORD}

# Enable replication from local to cloud
${BHS_LOCATION}->cloud.enabled = true
${BHS_LOCATION}->cloud.topics = ${KAFKA_TOPIC_PATTERNS}
# A topic that appears after MirrorMaker started is assigned only on this
# refresh; a fresh node's first events would otherwise wait for the default
# ten minutes.
refresh.topics.interval.seconds = 60

# Topics to replicate (regex pattern)
# Topics come from sync/tables/*.conf (setup-mirrormaker.sh) - use specific topics for better control
# Format: server-name.database.table1,server-name.database.table2
# Example: bahmni-local\.openmrs\.(person|patient|visit)

# Consumer configuration (reads from local Kafka)
${BHS_LOCATION}.consumer.bootstrap.servers = kafka:29092
${BHS_LOCATION}.consumer.group.id = ${MIRRORMAKER_CONSUMER_GROUP_ID}
${BHS_LOCATION}.consumer.key.deserializer = org.apache.kafka.common.serialization.ByteArrayDeserializer
${BHS_LOCATION}.consumer.value.deserializer = org.apache.kafka.common.serialization.ByteArrayDeserializer
${BHS_LOCATION}.consumer.auto.offset.reset = earliest
${BHS_LOCATION}.consumer.enable.auto.commit = true
# Buffer size for offline scenarios
${BHS_LOCATION}.consumer.fetch.min.bytes = 1
${BHS_LOCATION}.consumer.fetch.max.wait.ms = 500

# Producer configuration (writes to cloud Kafka)
cloud.producer.bootstrap.servers = ${REMOTE_KAFKA_BOOTSTRAP_SERVERS}
cloud.producer.key.serializer = org.apache.kafka.common.serialization.ByteArraySerializer
cloud.producer.value.serializer = org.apache.kafka.common.serialization.ByteArraySerializer
cloud.producer.acks = 1
# Infinite retries - will keep trying when offline
cloud.producer.retries = 2147483647
# Ensure ordering during reconnection
cloud.producer.max.in.flight.requests.per.connection = 1
# Timeout settings for offline handling
# Raised from the default (120000 = 2 min).
# delivery.timeout.ms is the HARD bound - `retries = MAX_INT` cannot exceed it.
# At 2 min any slow/interrupted link kills the task permanently ("will not recover
# until manually restarted"), defeating the offline-resilience intent. 2h here.
cloud.producer.delivery.timeout.ms = 7200000
cloud.producer.request.timeout.ms = 120000

# ---- throughput tuning ----
# max.in.flight=1 (kept, preserves ordering on retry) serialises batches, so
# throughput = batch size / RTT. Measured RTT ~40 ms => ~25 batches/s. Without
# linger/batching each batch carried <1 record => ~12 msg/s observed.
# Architecture 5.3 prescribes zstd compression for intermittent links.
# These change no ordering or durability semantics.
cloud.producer.linger.ms = 200
cloud.producer.batch.size = 524288
cloud.producer.compression.type = zstd
cloud.producer.buffer.memory = 67108864

# Replication settings
replication.policy.separator = .
replication.policy.class = org.apache.kafka.connect.mirror.DefaultReplicationPolicy

# Offset sync (tracks replication progress)
offset-syncs.topic.replication.factor = 1

# Heartbeat (for connectivity monitoring)
heartbeat.interval.seconds = 10

# Checkpoint interval (how often to sync offsets)
checkpoints.topic.replication.factor = 1

# Replication factor for internal topics
replication.factor = 1


# ---- topics (rendered by setup-mirrormaker.sh) ----

# ---- single-broker internal topics ----
${BHS_LOCATION}.offset.storage.replication.factor = 1
${BHS_LOCATION}.config.storage.replication.factor = 1
${BHS_LOCATION}.status.storage.replication.factor = 1
cloud.offset.storage.replication.factor = 1
cloud.config.storage.replication.factor = 1
cloud.status.storage.replication.factor = 1

# ---- down direction (cloud -> clinic). Generated here so a regenerate can never
#      silently drop the whole down direction.
# reverses (we CONSUME from the cloud instead of producing to it). Clinics stay
# behind NAT with no inbound reachability required.
cloud->${BHS_LOCATION}.enabled = true
cloud->${BHS_LOCATION}.topics = ${KAFKA_DOWN_TOPIC_PATTERNS}

# Consumer — reads from the CLOUD. This is the hop that crosses the internet.
cloud.consumer.bootstrap.servers = ${REMOTE_KAFKA_BOOTSTRAP_SERVERS}
cloud.consumer.group.id = mirrormaker-down-consumer-${BHS_LOCATION}
cloud.consumer.key.deserializer = org.apache.kafka.common.serialization.ByteArrayDeserializer
cloud.consumer.value.deserializer = org.apache.kafka.common.serialization.ByteArrayDeserializer
# earliest: a clinic that has been offline drains its backlog rather than skipping it
cloud.consumer.auto.offset.reset = earliest
cloud.consumer.enable.auto.commit = true
cloud.consumer.fetch.min.bytes = 1
cloud.consumer.fetch.max.wait.ms = 500

# ---- down-direction producer -----------------------------------------------
# Writes to the CLINIC's own broker, i.e. localhost. Unlike the up direction
# there is no bad link here, so acks=all costs nothing and is the durable
# setting. (The up direction runs acks=1 across the internet.)
${BHS_LOCATION}.producer.bootstrap.servers = kafka:29092
${BHS_LOCATION}.producer.key.serializer = org.apache.kafka.common.serialization.ByteArraySerializer
${BHS_LOCATION}.producer.value.serializer = org.apache.kafka.common.serialization.ByteArraySerializer
${BHS_LOCATION}.producer.acks = all
${BHS_LOCATION}.producer.retries = 2147483647
${BHS_LOCATION}.producer.max.in.flight.requests.per.connection = 1
# retries are capped by delivery.timeout.ms, so raise it
${BHS_LOCATION}.producer.delivery.timeout.ms = 7200000
${BHS_LOCATION}.producer.request.timeout.ms = 120000
