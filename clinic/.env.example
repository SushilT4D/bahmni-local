# ==== This clinic: every value here differs per clinic
BHS_LOCATION=<clinic-slug>
BHS_SITE_NUMBER=<site-number>
# Must differ from the Debezium connector's database.server.id.
MYSQL_SERVER_NAME=bahmni-<clinic-slug>
# Must match cluster.id in this node's Kafka data directory.
KAFKA_CLUSTER_ID=<generated>
DEBEZIUM_SERVER_ID=<18405-site-number>
LAN_NAME=bahmni.clinic

# ==== Sync setup: Kafka, Debezium and MirrorMaker

# ---- Kafka
KAFKA_IMAGE=confluentinc/cp-kafka:8.4.1
KAFKA_CONNECT_URL=http://localhost:8083
KAFKA_RETENTION_HOURS=168
KAFKA_RETENTION_BYTES=-1
KAFKA_MEM_LIMIT=1536m
KAFKA_NODE_HEAP_OPTS="-Xms256m -Xmx1g"
KAFKA_UI_MEM_LIMIT=512m
KAFKA_UI_JAVA_OPTS="-Xmx256m"

# ---- Debezium (Kafka Connect): the source that captures this clinic's OpenMRS changes
DEBEZIUM_CONNECT_IMAGE=quay.io/debezium/connect:3.7.1.Final
DEBEZIUM_SCRIPTING_VERSION=3.7.1.Final
GROOVY_VERSION=4.0.17
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=<debezium-db-password>
DEBEZIUM_SNAPSHOT_MODE=no_data
KAFKA_CONNECT_MEM_LIMIT=1536m
CONNECT_HEAP_OPTS="-Xms256m -Xmx768m"
LOCAL_CONNECT_URL=http://localhost:8083

# ---- MirrorMaker: the copy to and from the hub
MM2_IMAGE=confluentinc/cp-kafka-connect:8.4.1
REMOTE_KAFKA_BOOTSTRAP_SERVERS=<cloud-host>:9092
REMOTE_KAFKA_USERNAME=mirrormaker
REMOTE_KAFKA_PASSWORD=<remote-kafka-password>
REMOTE_KAFKA_SSL_TRUSTSTORE_PASSWORD=<truststore-password>
# SASL_SSL: TLS, trusting sync/cloud-ca.pem. SASL_PLAINTEXT only for a hub without a certificate.
REMOTE_KAFKA_SECURITY_PROTOCOL=SASL_SSL
REMOTE_KAFKA_SASL_MECHANISM=PLAIN
MIRRORMAKER_PRODUCER_RETRIES=2147483647
MIRRORMAKER_PRODUCER_MAX_IN_FLIGHT=1
MM2_MEM_LIMIT=1280m
MM2_HEAP_OPTS="-Xms256m -Xmx768m"
CLOUD_MYSQL_SERVER_NAME=bahmni-cloud
CLOUD_MYSQL_DATABASE=openmrs

# ---- Sync database logins: the sinks for rows arriving from the hub, and the OpenELIS source
OPENMRS_SINK_PASSWORD=<sink-db-password>
ODOO_SINK_PASSWORD=<odoo-sink-password>
CLINLIMS_SINK_PASSWORD=<clinlims-sink-password>
ODOO_SOURCE_PASSWORD=<odoo-source-password>
CLINLIMS_SOURCE_PASSWORD=<clinlims-source-password>

# ==== Applications

# ---- Host paths and runtime
CONTAINER_DATA_PATH=/absolute/path/to/bahmni-local
BAHMNI_CONFIG_PATH=/absolute/path/to/bahmni-local/bahmni_config
BAHMNI_UI_DIR=/absolute/path/to/bahmni-local/clinic/extracted/htdocs/bahmni
BAHMNI_CONFIG_DIR=/absolute/path/to/bahmni-local/clinic/extracted/bahmni_config
CERTIFICATE_PATH=/absolute/path/to/certs
TZ=Asia/Kolkata
RESTART_POLICY=unless-stopped
BAHMNI_APPS_PATH=/absolute/path/to/bahmni-local/bahmni-apps
CONFIG_BACKUP=/absolute/path/to/bahmni-local/config-backup

# ---- Bahmni web, proxy and helpers
BAHMNI_WEB_IMAGE=infoiplitin/bahmni-iplit-web:bhs-0.0.34
BAHMNI_CONFIG_IMAGE=infoiplitin/clinic-config-indiadistro:bhs-0.0.20
PROXY_IMAGE_TAG=1.0
BAHMNI_PROXY_HTTP_PORT=80
BAHMNI_PROXY_HTTPS_PORT=443
IMPLEMENTER_INTERFACE_IMAGE_TAG=1.1.0-74
IMPLEMENTER_INTERFACE_CODE_PATH=/absolute/path/to/bahmni-local/implementer-interface
PATIENT_DOCUMENTS_TAG=1.1.0-32
DOCUMENT_MAX_SIZE_MB=20
BAHMNI_LAB_IMAGE_TAG=2.0.1-195

# ---- OpenMRS
OPENMRS_IMAGE_NAME=infoiplitin/openmrs:iplit-1.2.0-1200-03
OPENMRS_HOST=openmrs
OPENMRS_PORT=8080
OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USERNAME=openmrs
OPENMRS_DB_PASSWORD=<openmrs-db-password>
OPENMRS_DB_AUTO_UPDATE=false
OPENMRS_DB_CREATE_TABLES=false
OPENMRS_DOCKER_ENV=false
OPENMRS_MODULE_WEB_ADMIN=false
OPENMRS_ATOMFEED_USER=admin
OPENMRS_ATOMFEED_PASSWORD=<openmrs-atomfeed-password>
BAHMNI_OPENMRS_MODULES_PATH=/absolute/path/to/bahmni-local/openmrs-modules
LUCENE_MATCH_TYPE=ANYWHERE
HEIGHT_CONCEPT_UUID=<height-concept-uuid>
WEIGHT_CONCEPT_UUID=<weight-concept-uuid>
OPENMRS_MEM_LIMIT=6g
OMRS_JAVA_MEMORY_OPTS="-Xms512m -Xmx2048m -XX:NewSize=128m -XX:MaxMetaspaceSize=512m"
OMRS_JAVA_SERVER_OPTS="-Dfile.encoding=UTF-8 -server -Djava.security.egd=file:/dev/./urandom -Djava.awt.headless=true"
OMRS_C3P0_MAX_SIZE=35
OMRS_DB_EXTRA_ARGS="&zeroDateTimeBehavior=convertToNull"
# Unset: the Initializer domains are the clinic default (clinic/install/initializer.sh).
#OPENMRS_INITIALIZER_DOMAINS=globalproperties,idgen
OPENMRS_ARM64_BASE_IMAGE=amazoncorretto:8u432-al2
LUCENE_SEARCH_INDEXING_STRATEGY=manual
OMRS_DB_DRIVER_CLASS=com.mysql.cj.jdbc.Driver
HIBERNATE_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false

# ---- MySQL (OpenMRS database)
MYSQL_IMAGE=mysql:8.0.46
MYSQL_ROOT_PASSWORD=<mysql-root-password>

# ---- Postgres (Odoo and OpenELIS databases)
POSTGRES_IMAGE=postgres:16
POSTGRES_DB=postgres
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=<postgres-superuser-password>

# ---- Odoo
ODOO_LOCAL_IMAGE=bahmni-local/odoo-16:1.0.0-arm64
ODOO_BAHMNI_IMAGE=docker.io/bahmni/odoo-16:1.0.0
ODOO_BASE_IMAGE=docker.io/library/odoo:16.0-20240826
ODOO_HOST=odoo
ODOO_PORT=8069
ODOO_DB_SERVER=bahmni-postgres
ODOO_DB_NAME=odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=<odoo-db-password>
ODOO_ATOMFEED_USER=emrsync
ODOO_ATOMFEED_PASSWORD=<odoo-atomfeed-password>
BAHMNI_ODOO_MODULES_PATH=/absolute/path/to/bahmni-local/odoo-modules
EXTRA_ODOO_ADDONS_PATH=/absolute/path/to/bahmni-local/odoo-addons
ODOO_MEM_LIMIT=1g
ODOO_DB_IMAGE_NAME=postgres:14

# ---- Odoo Connect
ODOO_CONNECT_IMAGE_TAG=1.0.0
ODOO_CONNECT_MEM_LIMIT=768m
ODOO_CONNECT_SERVER_OPTS="-Xms128m -Xmx384m -XX:MaxMetaspaceSize=192m"

# ---- OpenELIS
OPENELIS_IMAGE_TAG=1.1.0-111
OPENELIS_HOST=openelis
OPENELIS_PORT=8052
OPENELIS_DB_SERVER=bahmni-postgres
OPENELIS_DB_NAME=openelis
OPENELIS_DB_USER=clinlims
OPENELIS_DB_PASSWORD=<openelis-db-password>
OPENELIS_ATOMFEED_USER=atomfeed
OPENELIS_MEM_LIMIT=1536m
OPENELIS_DB_PORT=5432
OPENELIS_DB_USERNAME=clinlims
OPENELIS_ATOMFEED_PASSWORD=<openelis-atomfeed-password>

# ---- Atomfeed console
ATOMFEED_CONSOLE_MEM_LIMIT=768m
ATOMFEED_CONSOLE_JAVA_OPTS="-Xmx256m"
ATOMFEED_CONSOLE_IMAGE_TAG=1.0.0-23

# ---- Mail
SEND_MAIL=false
MAIL_TRANSPORT_PROTOCOL=smtp
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=25
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_SSL_ENABLE=false
MAIL_DEBUG=false
MAIL_USER=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM=<from-address>
