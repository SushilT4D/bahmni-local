# =============================================================================
# bahmni-local — clinic node environment
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored and MUST stay that way.
#
# QUOTING CONTRACT — this file is read two different ways, so both must work:
#   1. docker compose        (variable interpolation in docker-compose*.yml)
#   2. `set -a; source .env` (scripts/generate-local-sink-connectors.sh:29)
# Because of (2), any value containing a space, `&`, `!`, `#`, `$`, `;` or `|`
# MUST be double-quoted, or the shell will mis-parse the line and silently
# export an empty string. Values that are bare alphanumerics/paths need no quotes.
#
# NOTE: the cloud node has its OWN env file at cloud/.env — it is NOT
# this file. See cloud/.env.example.
# =============================================================================

# ---- host paths (absolute; bind-mounted into containers) ---------------------
CONTAINER_DATA_PATH=/absolute/path/to/bahmni-local
# The compose project name. It used to derive from the checkout directory
# (bahmni-local), which named this clinic's containers and volumes; since the
# compose project moved into clinic/ (Stage 4, 2026-09-15) the derived name would
# be "clinic" on every node -- so the SAME volumes would not attach and a node
# would come up with empty databases. Set it to what this node's containers and
# volumes are already called (Rawach: bahmni-local, Ghated: bahmni-ghated).
COMPOSE_PROJECT_NAME=
BAHMNI_APPS_PATH=/absolute/path/to/bahmni-local/bahmni-apps
BAHMNI_CONFIG_PATH=/absolute/path/to/bahmni-local/bahmni_config
BAHMNI_OPENMRS_MODULES_PATH=/absolute/path/to/bahmni-local/openmrs-modules
BAHMNI_ODOO_MODULES_PATH=/absolute/path/to/bahmni-local/odoo-modules
EXTRA_ODOO_ADDONS_PATH=/absolute/path/to/bahmni-local/odoo-addons
IMPLEMENTER_INTERFACE_CODE_PATH=/absolute/path/to/bahmni-local/implementer-interface
CONFIG_BACKUP=/absolute/path/to/bahmni-local/config-backup
RESTORE_ARTIFACTS_PATH=/absolute/path/to/bahmni-local/restore-artifacts
SNOWSTORM_RF2_FILE_PATH=/absolute/path/to/bahmni-local/snomed-rf2.zip
CERTIFICATE_PATH=/absolute/path/to/certs

# ---- runtime ----------------------------------------------------------------
TZ=Asia/Kolkata
RESTART_POLICY=unless-stopped
LOKI_URL=http://<loki-host>:3100/loki/api/v1/push

# ---- clinic identity (per-site; drives MM2 group ids + topic naming) ---------
# BHS_LOCATION is REQUIRED: scripts/setup-mirrormaker.sh:40 hard-fails without it.
# MIRRORMAKER_CONSUMER_GROUP_ID / MIRRORMAKER_CLUSTER_GROUP_ID are DERIVED from
# it (setup-mirrormaker.sh:58-59) — do not set them here.
BHS_LOCATION=<clinic-slug>
PHONE_NUMBER=<clinic-phone>

# ---- image tags -------------------------------------------------------------
# The twelve keys below are pinned by sync/versions.env; the installer
# overwrites these (clinic/install/tasks/020-env.sh calls lib.sh's
# versions_put). Values here just keep this file self-consistent for a manual
# read or a compose run outside the installer -- change the pin in
# sync/versions.env, not here.
OPENMRS_IMAGE_NAME=infoiplitin/openmrs:iplit-1.2.0-1200-03
ODOO_IMAGE_NAME=bahmni/odoo-16:1.0.0
MYSQL_IMAGE=mysql:8.0.39
POSTGRES_IMAGE=postgres:16
KAFKA_IMAGE=confluentinc/cp-kafka:8.3.2
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:8.3.2
MM2_IMAGE=confluentinc/cp-kafka-connect:8.3.2
DEBEZIUM_CONNECT_IMAGE=quay.io/debezium/connect:3.6.2.Final
DEBEZIUM_SCRIPTING_VERSION=3.6.2.Final
GROOVY_VERSION=4.0.22
ODOO_CONNECT_IMAGE_TAG=1.0.0
OPENELIS_IMAGE_TAG=1.1.0-111
# not fleet-pinned (sync/versions.env does not cover these)
CONFIG_IMAGE_NAME=bahmni/default-config:latest
ODOO_DB_IMAGE_NAME=postgres:14
BAHMNI_WEB_IMAGE_TAG=1.1.0-107
BAHMNI_LAB_IMAGE_TAG=latest
PROXY_IMAGE_TAG=1.0
CDSS_IMAGE_TAG=latest
IMPLEMENTER_INTERFACE_IMAGE_TAG=latest
PATIENT_DOCUMENTS_TAG=latest
SNOWSTORM_LITE_IMAGE_TAG=latest

# ---- proxy ------------------------------------------------------------------
BAHMNI_PROXY_HTTP_PORT=8081
BAHMNI_PROXY_HTTPS_PORT=9443

# ---- OpenMRS ----------------------------------------------------------------
OPENMRS_HOST=openmrs
OPENMRS_PORT=8080
OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USERNAME=openmrs
OPENMRS_DB_PASSWORD=<openmrs-db-password>
OPENMRS_DB_AUTO_UPDATE=true
OPENMRS_DB_CREATE_TABLES=false
OPENMRS_DOCKER_ENV=false
OPENMRS_MODULE_WEB_ADMIN=true
OPENMRS_ATOMFEED_USER=superman
OPENMRS_ATOMFEED_PASSWORD=<openmrs-atomfeed-password>
LUCENE_MATCH_TYPE=ANYWHERE
DOCUMENT_MAX_SIZE_MB=20
HEIGHT_CONCEPT_UUID=<height-concept-uuid>
WEIGHT_CONCEPT_UUID=<weight-concept-uuid>

# JVM opts contain spaces -> MUST be double-quoted (see QUOTING CONTRACT above).
# Rawach's proven cap for a 121k-patient clinic (F-050: an uncapped heap on a
# VM this size OOM-looped); the template used to carry only NewSize.
OMRS_JAVA_MEMORY_OPTS="-Xms512m -Xmx2048m -XX:NewSize=128m -XX:MaxMetaspaceSize=512m"
# -XX:-UseContainerSupport: this image's Java 8u372 throws a NullPointerException
# from jdk.internal.platform (cgroup v2 metrics) on an Azure Ubuntu 24.04 host,
# so Tomcat dies registering its MBeans and the container restart-loops; the flag
# skips that code (reproduced on the hub 2026-09-17, first live clinic manpur).
# The JVM then ignores the cgroup limit for heap sizing, which is why the heap
# below is pinned explicitly. Harmless where the bug does not trigger (Rawach).
OMRS_JAVA_SERVER_OPTS="-Dfile.encoding=UTF-8 -server -Djava.security.egd=file:/dev/./urandom -Djava.awt.headless=true -XX:-UseContainerSupport"
OMRS_C3P0_MAX_SIZE=35
# Leading `&` MUST be quoted, or `source .env` parses it as a background job
# and exports an empty string.
OMRS_DB_EXTRA_ARGS="&zeroDateTimeBehavior=convertToNull"
HIBERNATE_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false

# ---- MySQL (clinic OpenMRS) -------------------------------------------------
BAHMNI_MYSQL_HOST=bahmni-mysql
MYSQL_SERVER_NAME=bahmni-<clinic-slug>
MYSQL_ROOT_PASSWORD=<mysql-root-password>
DATABASE_NAME=openmrs
DATABASE_INCLUDE_LIST=openmrs

# ---- Odoo -------------------------------------------------------------------
ODOO_DB_HOST=bahmni-postgres
ODOO_DB_NAME=odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=<odoo-db-password>

# ---- OpenELIS (Module 28: runs on the shared bahmni-postgres, PG15) ---------
OPENELIS_HOST=openelis
OPENELIS_PORT=8052
OPENELIS_DB_SERVER=bahmni-postgres
OPENELIS_DB_PORT=5432
OPENELIS_DB_NAME=openelis
OPENELIS_DB_USER=clinlims
OPENELIS_DB_PASSWORD=<openelis-db-password>
OPENELIS_ATOMFEED_USER=atomfeed
OPENELIS_ATOMFEED_PASSWORD=<openelis-atomfeed-password>
# openelis/start-no-migrate.sh reads OPENELIS_DB_USERNAME, while docker-compose
# reads OPENELIS_DB_USER. Set BOTH to the same value until the alias is unified.
OPENELIS_DB_USERNAME=clinlims

# ---- Snowstorm / CDSS -------------------------------------------------------
SNOWSTORM_LITE_ADMIN_PASSWORD=<snowstorm-admin-password>
SNOWSTORM_LITE_JAVA_SERVER_OPTS=-Xmx2g
CDSS_JAVA_SERVER_OPTS=-Xmx512m

# ---- mail -------------------------------------------------------------------
SEND_MAIL=false
MAIL_TRANSPORT_PROTOCOL=smtp
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=25
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_SSL_ENABLE=false
MAIL_DEBUG=false
MAIL_USER=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM=<from-address>

# =============================================================================
# SYNC — clinic side
# =============================================================================

# ---- Debezium source (clinic OpenMRS -> Kafka) ------------------------------
# connectors/mysql-source-connector.json and mysql-local-source-connector.json
# carry ${DEBEZIUM_DB_PASSWORD} as a placeholder — never a literal password.
# LOCAL_DEBEZIUM_* is the docker-compose spelling; DEBEZIUM_DB_* is the
# connector-template spelling. Set both to the same credential.
LOCAL_DEBEZIUM_USER=debezium
LOCAL_DEBEZIUM_PASSWORD=<debezium-db-password>
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=<debezium-db-password>
# Comma-separated db.table list for the source connector template.
TABLE_INCLUDE_LIST=openmrs.patient,openmrs.person,openmrs.encounter

# ---- MirrorMaker 2 (clinic <-> cloud Kafka) ---------------------------------
# REQUIRED: setup-mirrormaker.sh:51 hard-fails if unset.
REMOTE_KAFKA_BOOTSTRAP_SERVERS=<cloud-host>:9092
REMOTE_KAFKA_USERNAME=mirrormaker
REMOTE_KAFKA_PASSWORD=<remote-kafka-password>
REMOTE_KAFKA_SSL_TRUSTSTORE_PASSWORD=<truststore-password>
KAFKA_RETENTION_HOURS=168
KAFKA_RETENTION_BYTES=-1
# Optional: auto-derived from hub/tables.conf when unset
# (setup-mirrormaker.sh:73-85). Set only to override.
#KAFKA_TOPIC_PATTERNS=(topic1|topic2)
# Legacy MM2 path only (setup-mirrormaker.sh:99-102); defaults shown.
#MIRRORMAKER_PRODUCER_RETRIES=2147483647
#MIRRORMAKER_PRODUCER_MAX_IN_FLIGHT=1

# ---- DOWN-direction sink generator (cloud -> clinic) ------------------------
# Consumed by scripts/generate-local-sink-connectors.sh. Its output directory,
# debezium/local/connectors/generated/, is GITIGNORED: the rendered connectors
# carry the injected password and must never be committed. Regenerate with:
#   ./scripts/generate-local-sink-connectors.sh
LOCAL_MYSQL_HOST=bahmni-mysql
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_DATABASE=openmrs
LOCAL_MYSQL_USE_SSL=false
LOCAL_MYSQL_USER=sink
LOCAL_MYSQL_PASSWORD=<sink-db-password>
# SINK_DB_USER / SINK_DB_PASSWORD are fallback aliases for the two above
# (generate-local-sink-connectors.sh:38-39). Leave unset unless you need them.
#SINK_DB_USER=sink
#SINK_DB_PASSWORD=<sink-db-password>

# Cloud-side naming, used to build the mirrored topic prefix
#   ${MM2_REMOTE_ALIAS}.${CLOUD_MYSQL_SERVER_NAME}.${CLOUD_MYSQL_DATABASE}.<table>
MM2_REMOTE_ALIAS=remote
CLOUD_MYSQL_SERVER_NAME=bahmni-cloud
CLOUD_MYSQL_DATABASE=openmrs

# Kafka Connect REST endpoint used by scripts/register-local-sink-connectors.sh
LOCAL_CONNECT_URL=http://localhost:8083

# clinlims CDC credentials (F-026): the sink role and the source (capture) role
CLINLIMS_SINK_PASSWORD=""
CLINLIMS_SOURCE_PASSWORD=""

# KRaft cluster id for THIS node. Must match the cluster.id in
# data/kafka/meta.properties on this machine - it is node-specific, so never
# copy another clinic. The Confluent image requires it whenever the broker runs
# in KRaft mode and fails at boot with a bare "CLUSTER_ID is required."
# Read it with: grep cluster.id data/kafka/meta.properties
KAFKA_CLUSTER_ID=

# Host port for the Odoo TLS vhost. nginx listens on 444 inside the proxy container
# and serves Odoo at ROOT there. Odoo emits absolute URLs (/web, /web/static,
# /longpolling) so it cannot be served under a sub-path like /odoo.
BAHMNI_ODOO_HTTPS_PORT=9444

# ═══════════════════════════════════════════════════════════════════════════
# NODE IDENTITY — every value below differs per clinic (added 2026-09-14)
# ═══════════════════════════════════════════════════════════════════════════
# These exist so that ONE branch runs on EVERY clinic. Nothing that identifies
# a node belongs in a tracked file; it all lives here, and this file is the
# committed contract for what a node must supply.

# Compose project name. Namespaces containers, the network and every named
# volume (a volume declared `foo` becomes `<project>_foo`). Must be unique per
# node. Lab: bahmni-local = Rawach, bahmni-ghated = Ghated.

# This node's strided residue, from clinics.txt. REQUIRED (:? in
# docker-compose.override.yml) so a node that omits it fails to start rather
# than defaulting into another clinic's residue. Together with
# --auto-increment-increment=10 this makes every row's origin computable from
# its own primary key, which L-008 and L-010 both rest on. NEVER reuse a
# residue, and never change one on a node that has already written rows.
MYSQL_AUTO_INCREMENT_OFFSET=

# MySQL's own server_id. REQUIRED. Must NOT equal the database.server.id of any
# Debezium connector reading this server: a duplicate id in one replication
# topology is the classic cause of the source dropping the replica (F-059).
# Rawach runs 1 against a Debezium id of 184054.
MYSQL_SERVER_ID=

# FULL names of this node's Odoo volumes, including the compose project prefix.
# REQUIRED, and no default on purpose: a wrong value does not error, it mounts
# an EMPTY volume, so Odoo comes up with a blank database while the real data
# sits untouched under the old name. Read the real ones first:
#   docker volume ls | grep odoo
# Rawach: bahmni-local_odoodb-data / bahmni-local_odooapp-data
# Ghated: bahmni-ghated_ghated-odoodb / bahmni-ghated_ghated-odooapp
ODOO_DB_VOLUME_NAME=
ODOO_APP_VOLUME_NAME=

# This node's MirrorMaker cluster alias — the FIRST segment of every topic the
# hub receives from it (e.g. source.bahmni-local.openmrs.person from Rawach,
# ghated.bahmni-ghated.openmrs.person from Ghated). Defaults to "source", which
# is clinic 1's alias, so a second clinic MUST set it or its topics collide
# with clinic 1's on the hub.
LOCAL_CLUSTER_ALIAS=<clinic-slug>
