<configuration>

    <!-- Mounted over the image's WEB-INF/classes/logback.xml for odoo-connect.

         WHY. The shipped file sets root level DEBUG with a CONSOLE appender. The
         file appender rolls (5 MB x 10); the console one does not, and console is
         what becomes the container's json.log. With Apache HttpClient's
         org.apache.http.wire logger at DEBUG, every HTTP header of every ATOM
         feed poll is written out. On Rawach that measured 3,857 MB in roughly
         three hours, about 1.3 GB/hour, and it was the single largest consumer of
         a 58 GB VM disk twice in one day.

         Docker log rotation bounds the damage. This bounds the cause. Both are
         needed: rotation alone still writes 1.3 GB/hour and merely discards it.

         Root is INFO, and the wire/headers loggers are pinned at WARN
         explicitly, so raising root back to DEBUG for a real investigation does
         not silently re-enable full HTTP dumps. -->

    <property name="basePath" value="${sys:catalina.base}" />

    <appender name="file" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${basePath}/logs/openerp-feed-service.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${basePath}/logs/openerp-feed-service-%d{MM-dd-yyyy}-%i.log</fileNamePattern>
            <maxFileSize>5000KB</maxFileSize>
            <maxHistory>10</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d %-5p [openerp-atomfeed-service][%c] %m%n</pattern>
        </encoder>
    </appender>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <target>SYSTEM_OUT</target>
        <encoder>
            <pattern>%d %-5p [openerp-atomfeed-service][%c] %m%n</pattern>
        </encoder>
    </appender>

    <!-- The actual offenders, pinned regardless of root. -->
    <logger name="org.apache.http.wire"    level="WARN" />
    <logger name="org.apache.http.headers" level="WARN" />
    <logger name="org.apache.http"         level="WARN" />
    <logger name="httpclient.wire"         level="WARN" />

    <root level="INFO">
        <appender-ref ref="file" />
        <appender-ref ref="console" />
    </root>

</configuration>
