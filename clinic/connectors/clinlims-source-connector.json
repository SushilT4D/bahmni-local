{
  "name": "clinlims-source-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "slot.name": "dbz_clinlims_up",
    "tasks.max": "1",
    "publication.name": "dbz_clinlims_owned",
    "transforms": "ownRows_system_user,ownRows_result_signature,agg",
    "transforms.ownRows_system_user.type": "io.debezium.transforms.Filter",
    "transforms.ownRows_system_user.language": "jsr223.groovy",
    "transforms.ownRows_system_user.condition": "${CLINLIMS_UP_CONDITION_SYSTEM_USER}",
    "transforms.ownRows_system_user.null.handling.mode": "evaluate",
    "transforms.ownRows_system_user.predicate": "topicIs_system_user",
    "transforms.ownRows_result_signature.type": "io.debezium.transforms.Filter",
    "transforms.ownRows_result_signature.language": "jsr223.groovy",
    "transforms.ownRows_result_signature.condition": "${CLINLIMS_UP_CONDITION_RESULT_SIGNATURE}",
    "transforms.ownRows_result_signature.null.handling.mode": "evaluate",
    "transforms.ownRows_result_signature.predicate": "topicIs_result_signature",
    "predicates": "topicIs_system_user,topicIs_result_signature",
    "predicates.topicIs_system_user.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.topicIs_system_user.pattern": "${MYSQL_SERVER_NAME}\\.clinlims\\.system_user",
    "predicates.topicIs_result_signature.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.topicIs_result_signature.pattern": "${MYSQL_SERVER_NAME}\\.clinlims\\.result_signature",
    "schema.include.list": "clinlims",
    "topic.prefix": "${MYSQL_SERVER_NAME}",
    "decimal.handling.mode": "double",
    "heartbeat.action.query": "INSERT INTO clinlims.dbz_heartbeat (id, ts) VALUES (1, now()) ON CONFLICT (id) DO UPDATE SET ts = EXCLUDED.ts",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "publication.autocreate.mode": "disabled",
    "transforms.agg.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "database.user": "clinlims",
    "database.dbname": "openelis",
    "time.precision.mode": "connect",
    "heartbeat.interval.ms": "60000",
    "transforms.agg.regex": "${MYSQL_SERVER_NAME}\\.clinlims\\.(sample|sample_item|analysis|result|person|patient|patient_identity|provider|sample_human|system_user|result_signature)$",
    "database.port": "5432",
    "plugin.name": "pgoutput",
    "key.converter.schemas.enable": "true",
    "database.hostname": "bahmni-postgres",
    "database.password": "${CLINLIMS_SOURCE_PASSWORD}",
    "value.converter.schemas.enable": "true",
    "transforms.agg.replacement": "${MYSQL_SERVER_NAME}.clinlims.all",
    "table.include.list": "clinlims.sample,clinlims.sample_item,clinlims.analysis,clinlims.result,clinlims.person,clinlims.patient,clinlims.patient_identity,clinlims.provider,clinlims.sample_human,clinlims.system_user,clinlims.result_signature,clinlims.dbz_heartbeat",
    "snapshot.mode": "no_data",
    "schemas.enable": "true",
    "slot.stream.params": "origin=none"
  }
}
