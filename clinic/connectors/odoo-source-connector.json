{
  "name": "odoo-source-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "slot.name": "dbz_odoo_up",
    "tasks.max": "1",
    "publication.name": "dbz_odoo_owned",
    "transforms": "route,agg",
    "schema.include.list": "public",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "topic.prefix": "${MYSQL_SERVER_NAME}",
    "transforms.route.regex": "${MYSQL_SERVER_NAME}\\.public\\.(.*)",
    "decimal.handling.mode": "double",
    "heartbeat.action.query": "INSERT INTO public.dbz_heartbeat (id, ts) VALUES (1, now()) ON CONFLICT (id) DO UPDATE SET ts = EXCLUDED.ts",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "transforms.route.replacement": "${MYSQL_SERVER_NAME}.odoo.$1",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "publication.autocreate.mode": "disabled",
    "transforms.agg.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "database.user": "odoo",
    "database.dbname": "odoo",
    "time.precision.mode": "connect",
    "heartbeat.interval.ms": "60000",
    "transforms.agg.regex": "${MYSQL_SERVER_NAME}\\.odoo\\.(res_partner|res_country_state|product_template|product_product|product_category|uom_uom|sale_order|sale_order_line|stock_move|stock_quant|stock_picking|account_move|account_move_line|state_district|district_subdistrict|village_village|res_partner_attributes|product_taxes_rel|product_supplier_taxes_rel|stock_route_product)$",
    "database.port": "5432",
    "plugin.name": "pgoutput",
    "key.converter.schemas.enable": "true",
    "database.hostname": "bahmni-postgres",
    "database.password": "${ODOO_DB_PASSWORD}",
    "value.converter.schemas.enable": "true",
    "transforms.agg.replacement": "${MYSQL_SERVER_NAME}.odoo.all",
    "table.include.list": "public.res_country_state,public.res_partner,public.product_template,public.product_product,public.product_category,public.uom_uom,public.sale_order,public.sale_order_line,public.stock_move,public.stock_quant,public.stock_picking,public.account_move,public.account_move_line,public.state_district,public.district_subdistrict,public.village_village,public.res_partner_attributes,public.product_taxes_rel,public.product_supplier_taxes_rel,public.stock_route_product,public.dbz_heartbeat",
    "snapshot.mode": "no_data",
    "slot.stream.params": "origin=none"
  }
}
