# Answer file for clinic/install/install.sh -- the HAND-WRITTEN path (--answers).
# The normal path is `install.sh --clinic <slug>`, which composes these twelve
# values from sync/fleet/<slug>.env (identity), sync/clinics.txt (residue),
# sync/hub.env (hub endpoint) and <seed>/secrets.env (the four passwords), asks
# on the terminal for anything still missing, and keeps the result in
# ~/clinic-<slug>.env. Use this file only for a clinic that is not registered.
# Copy to clinic-<slug>.env, fill, chmod 600. It is `source`d: a value with a
# space, &, !, #, $, ; or | must be double-quoted.

# --- identity (fleet-unique; the residue MUST already be a committed row
#     `<slug>:<residue>` in sync/clinics.txt -- the installer refuses otherwise)
CLINIC_SLUG=            # lowercase, e.g. azure -> containers bahmni-azure-*, topics bahmni-azure.*
RESIDUE=                # 1-9, free today: 7 8 9 (docs/sync-core/residues.txt)
MRN_PREFIX=             # three letters, e.g. AZR (L-010 business identifier)
SITE_NUMBER=            # OpenELIS site number, usually = RESIDUE
CLINIC_PHONE=           # E.164, e.g. +919999999999

# --- the name the proxy certificate is issued for (SAN). No DNS is configured.
CERT_HOSTNAME=          # e.g. azure-clinic.eastus.cloudapp.azure.com

# --- the hub (ask the operator; L-007 mTLS/ACLs are unmet, this is the fleet's SASL user)
REMOTE_KAFKA_BOOTSTRAP_SERVERS=   # e.g. samyogas-mac-mini.tailca2651.ts.net:9092
REMOTE_KAFKA_USERNAME=mirrormaker
REMOTE_KAFKA_PASSWORD=

# --- must match users already inside the seed dumps (ask the operator who made them)
OPENMRS_ATOMFEED_PASSWORD=
OPENELIS_ATOMFEED_PASSWORD=
ODOO_ATOMFEED_PASSWORD=
