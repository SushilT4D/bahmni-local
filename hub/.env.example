# Environment for the hub/ compose project (the sync layer: Kafka, Schema
# Registry, Kafka Connect). Copy to .env and fill in. Split out of cloud/.env
# when the sync layer became its own compose project (see hub/README.md).
#
# Every secret below is BLANK on purpose, and this file is a KEY LIST, not a
# file anyone fills in: hub/install/install.sh composes the real hub/.env
# (mode 600, gitignored) itself, through hub_compose_env (hub/install/lib.sh),
# from exactly three sources --
#
#   1. sync/hub.env                  the fleet's own endpoint pointer
#                                    (REMOTE_KAFKA_BOOTSTRAP_SERVERS -> REMOTE_KAFKA_HOST);
#   2. --base-env <path>             the BASE stack's own .env: the credentials
#                                    that already exist there (ODOO_DB_PASSWORD,
#                                    OPENELIS_DB_PASSWORD, any sink password a
#                                    previous install set);
#   3. --secrets <path>              the operator's own file, holding the fleet
#                                    SASL password (REMOTE_KAFKA_PASSWORD).
#
# Anything none of the three supplies is generated (gen_secret) or defaulted.
# A value already present in hub/.env always wins, so a resume never
# regenerates a secret. The four base-stack coordinates -- BASE_MYSQL_CONTAINER,
# BASE_PG_CONTAINER/BASE_PG_SUPERUSER, BASE_ELIS_CONTAINER/BASE_ELIS_SUPERUSER
# -- additionally take a value straight from the install command's own
# environment, which is how a two-container base (IPLIT's) is described; see
# hub/README.md's Install section for the full command.
#
# Do not hand-fill a real secret here and commit it: this file IS tracked.

# KRaft cluster id for the hub's Kafka broker; must match the kafka-data
# volume's meta.properties. Read with: grep cluster.id <volume>/meta.properties
# -- never copy another node's value.
KAFKA_CLUSTER_ID=

# Hostname/IP the hub's Kafka broker advertises on its SASL_PLAINTEXT
# listener, for remote clinics to dial into (the advertised listener, not
# the internal PLAINTEXT one kafka-connect uses).
REMOTE_KAFKA_HOST=

# Host interface the clinic-facing SASL_PLAINTEXT listener (port 9092) is
# PUBLISHED on. 0.0.0.0 -- the default, and what a real hub wants: every
# clinic dials this port from the internet. A lab hub that fronts 9092 with
# `tailscale serve` (or any local proxy) sets 127.0.0.1 here on purpose;
# tasks 060 and 090 read the binding back from the running container and warn
# loudly that clinics cannot dial it.
KAFKA_SASL_BIND=

# Docker network name of the base application stack (cloud/ or clinic/) this
# hub attaches to, e.g. cloud_default -- that stack's compose project name
# plus "_default".
KAFKA_BASE_NETWORK=

# SASL PLAIN password for the broker's own "admin" JAAS user; goes into the
# generated kafka_server_jaas.conf (task 030), never committed.
KAFKA_ADMIN_PASSWORD=

# SASL PLAIN password remote clients (clinic MirrorMaker producers) present
# when authenticating to this hub's SASL_PLAINTEXT listener at REMOTE_KAFKA_HOST.
REMOTE_KAFKA_PASSWORD=

# MySQL user the down-direction Debezium source connector (cloud -> clinic)
# logs in as; a CDC user on the base stack's openmrsdb.
DEBEZIUM_DB_USER=

# Password for the DEBEZIUM_DB_USER MySQL account above.
DEBEZIUM_DB_PASSWORD=

# Host of the MySQL server the up-sink connectors WRITE INTO -- the base
# stack's openmrsdb service.
REMOTE_MYSQL_HOST=

# Port of that same sink-target MySQL server (3306 by default).
REMOTE_MYSQL_PORT=

# Database name on the sink-target MySQL server (openmrs).
REMOTE_MYSQL_DATABASE=

# MySQL role the JDBC sink connectors use to write into REMOTE_MYSQL_HOST.
REMOTE_MYSQL_USER=

# Password for the REMOTE_MYSQL_USER role above.
REMOTE_MYSQL_PASSWORD=

# Whether the JDBC sinks connect to REMOTE_MYSQL_HOST over SSL (true/false).
REMOTE_MYSQL_USE_SSL=

# Password the odoo-*-sink-all connector templates use for the Postgres role
# that writes into the hub's Odoo replica (the odoo_sink role).
ODOO_SINK_PASSWORD=

# Password every clinic's clinlims-<slug>-sink-all connector uses; the
# Postgres role clinlims_sink on the hub's OpenELIS replica must carry the
# same value.
CLINLIMS_SINK_PASSWORD=

# Debezium logical server name (topic-prefix) for the cloud-side MySQL
# source connector; must not collide with any clinic's own server name.
CLOUD_MYSQL_SERVER_NAME=

# MySQL replication server-id the cloud-side Debezium connector presents;
# must be unique across every consumer of that binlog (source + all clinics).
CLOUD_DEBEZIUM_SERVER_ID=

# Base URL the register-*/generate-* scripts use to reach Kafka Connect's
# REST API, e.g. http://localhost:8083.
KAFKA_CONNECT_URL=

# Postgres superuser name on the base stack's Odoo Postgres -- the role that
# base actually bootstrapped: "postgres" on the mini and every clinic, "odoo"
# on IPLIT's base. Taken from the install command's environment first, then
# the base .env's POSTGRES_USER, then "postgres".
#
# (BASE_MYSQL_ROOT_PASSWORD and BASE_PG_PASSWORD used to sit here. Both were
# dropped: nothing read either one. MySQL root is used only through the base
# container's own MYSQL_ROOT_PASSWORD environment, and psql runs over the
# container's local socket, which its image trusts -- so copying two more live
# credentials into this file bought nothing but exposure.)
BASE_PG_SUPERUSER=

# Container name of the base stack's MySQL service (e.g. cloud-openmrsdb-1),
# for hub scripts that docker exec into it.
BASE_MYSQL_CONTAINER=

# Container name of the base stack's Postgres service (e.g.
# cloud-openelisdb-1), for hub scripts that docker exec into it.
BASE_PG_CONTAINER=

# Container name of the base stack's Postgres service that hosts the
# OpenELIS/clinlims database -- one container for both databases on the mini
# and the clinics (defaults to BASE_PG_CONTAINER's value); IPLIT's base uses
# two.
BASE_ELIS_CONTAINER=

# Postgres superuser name on the OpenELIS/clinlims Postgres container above
# -- one container for both databases on the mini and the clinics (defaults
# to BASE_PG_SUPERUSER's value); IPLIT's base uses two.
BASE_ELIS_SUPERUSER=

# Hostname the down-direction MySQL source connector dials -- defaults to
# BASE_MYSQL_CONTAINER's value (Docker resolves container names on the
# shared KAFKA_BASE_NETWORK).
CLOUD_MYSQL_HOST=

# Port of the base stack's MySQL server the down-direction source reads from.
CLOUD_MYSQL_PORT=

# Database name on the base stack's MySQL server the down-direction source
# captures from (openmrs).
CLOUD_MYSQL_DATABASE=

# The base stack's ODOO_DB_PASSWORD (the "odoo" Postgres role); the
# odoo-cloud-source connector logs in with it. Copy from the base .env --
# do not invent a new value.
ODOO_DB_PASSWORD=

# The base stack's OPENELIS_DB_PASSWORD (the "clinlims" Postgres role); the
# clinlims-cloud-source connector logs in with it. Copy from the base .env.
CLINLIMS_SOURCE_PASSWORD=

# Debezium logical server name the odoo-cloud-source and clinlims-cloud-source
# templates reference as ${REMOTE_SERVER_NAME} (e.g. bahmni-cloud).
REMOTE_SERVER_NAME=

# Login for the kafka-ui service (task 070), bound to 127.0.0.1:8080 only.
# Defaults to "admin" -- not a secret by itself, just a username.
KAFKA_UI_USER=

# Password for KAFKA_UI_USER above; generated by hub_compose_env like every
# other secret in this file.
KAFKA_UI_PASSWORD=
