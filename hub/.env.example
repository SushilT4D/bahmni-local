# Hub sync-layer environment. Copy to hub/.env (mode 600, gitignored).

# ---- Kafka
# Must match cluster.id in the kafka-data volume.
KAFKA_CLUSTER_ID=
REMOTE_KAFKA_HOST=
# Interface port 9092 is published on: 0.0.0.0, or 127.0.0.1 behind a local proxy.
KAFKA_SASL_BIND=
# Clinic listener: SASL_SSL (default; needs hub/tls/) or SASL_PLAINTEXT (no TLS).
KAFKA_CLINIC_PROTOCOL=
# Keystore file in hub/tls/ and its type; default kafka.keystore.p12, PKCS12.
KAFKA_SSL_KEYSTORE_FILENAME=
KAFKA_SSL_KEYSTORE_TYPE=
# The application stack's compose network: its project name plus "_default".
KAFKA_BASE_NETWORK=
KAFKA_ADMIN_PASSWORD=
REMOTE_KAFKA_PASSWORD=
KAFKA_CONNECT_URL=
KAFKA_UI_USER=
KAFKA_UI_PASSWORD=

# ---- down direction: capture from the hub's OpenMRS, Odoo and OpenELIS
DEBEZIUM_DB_USER=
DEBEZIUM_DB_PASSWORD=
# Topic prefix; must differ from every clinic's.
CLOUD_MYSQL_SERVER_NAME=
# Unique among every reader of this MySQL binlog.
CLOUD_DEBEZIUM_SERVER_ID=
CLOUD_MYSQL_HOST=
CLOUD_MYSQL_PORT=
CLOUD_MYSQL_DATABASE=
# The application stack's own odoo and clinlims role passwords.
ODOO_DB_PASSWORD=
CLINLIMS_SOURCE_PASSWORD=
REMOTE_SERVER_NAME=

# ---- up direction: sinks writing clinic rows into the hub's databases
REMOTE_MYSQL_HOST=
REMOTE_MYSQL_PORT=
REMOTE_MYSQL_DATABASE=
REMOTE_MYSQL_USER=
REMOTE_MYSQL_PASSWORD=
REMOTE_MYSQL_USE_SSL=
ODOO_SINK_PASSWORD=
CLINLIMS_SINK_PASSWORD=

# ---- application stack containers
BASE_MYSQL_CONTAINER=
BASE_PG_CONTAINER=
BASE_PG_SUPERUSER=
# Leave empty when Odoo and OpenELIS share one Postgres container.
BASE_ELIS_CONTAINER=
BASE_ELIS_SUPERUSER=
