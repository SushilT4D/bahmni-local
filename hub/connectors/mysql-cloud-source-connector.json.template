{
  "name": "mysql-cloud-source-connector",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",

    "database.hostname": "${CLOUD_MYSQL_HOST}",
    "database.port": "${CLOUD_MYSQL_PORT}",
    "database.user": "${DEBEZIUM_DB_USER}",
    "database.password": "${DEBEZIUM_DB_PASSWORD}",

    "//": "REPLICA id presented to cloud MySQL. Must differ from the clinic source (184054).",
    "database.server.id": "${CLOUD_DEBEZIUM_SERVER_ID}",

    "//topic-prefix": "down topics are bahmni-cloud.openmrs.* -- deliberately distinct from the",
    "//topic-prefix2": "clinic's bahmni-local.* so the two directions can never alias each other.",
    "topic.prefix": "${CLOUD_MYSQL_SERVER_NAME}",

    "database.include.list": "${CLOUD_MYSQL_DATABASE}",

    "//whitelist": "THE LOOP GUARD. The cloud binlog also records every UP-direction sink",
    "//whitelist2": "write (121k patients). Capturing those here would send clinic data straight",
    "//whitelist3": "back down = an infinite loop. Only cloud-OWNED tables may appear.",
    "table.include.list": "${TABLE_INCLUDE_LIST}",

    "schema.history.internal.kafka.bootstrap.servers": "${CLOUD_KAFKA_BOOTSTRAP}",
    "schema.history.internal.kafka.topic": "schema-changes.${CLOUD_MYSQL_SERVER_NAME}",
    "schema.history.internal.store.only.captured.tables.ddl": "true",

    "//snapshot": "when_needed: a connector that already has offsets resumes from them, and",
    "//snapshot2": "snapshots only when it has none or the binlog no longer holds them, so a",
    "//snapshot3": "config re-registered under the same name does not re-send the master",
    "//snapshot4": "tables. A new Kafka has no offsets: the first start snapshots.",
    "snapshot.mode": "when_needed",
    "snapshot.locking.mode": "minimal",

    "//converters": "schemas.enable MUST be true on BOTH sides. 'They must match' is",
    "//converters2": "necessary but NOT sufficient. The Debezium JDBC sink",
    "//converters3": "needs the SCHEMA to build its upsert; matched-but-false fails with",
    "//converters4": "'Configured primary key mode record_key cannot have null schema'.",
    "//converters5": "The working up direction runs true/true; this now matches it.",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "true",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",

    "tombstones.on.delete": "true",

    "//heartbeat": "Commits a fresh source offset every minute even when no captured table",
    "//heartbeat2": "changes, so an idle source still shows it is reading the binlog.",
    "heartbeat.interval.ms": "60000"
  }
}
